[
  {
    "id": "eureka-dev",
    "kind": "discovery",
    "provider": "discovery.eureka",
    "environment": "dev",
    "config": {
      "url": "http://127.0.0.1:8761/eureka",
      "bearer_token_env": "EUREKA_TOKEN"
    },
    "allowed_operations": ["instances"]
  },
  {
    "id": "existing-repository",
    "kind": "repository",
    "provider": "repository.git",
    "environment": "local",
    "config": {"path": "/absolute/path/to/repository"},
    "allowed_operations": ["status", "diff"]
  },
  {
    "id": "existing-test-engine",
    "kind": "testing",
    "provider": "testing.command",
    "environment": "dev",
    "config": {
      "path": "/absolute/path/to/test-engine",
      "suites": {
        "smoke": ["/absolute/path/to/test-engine/.venv/bin/robot", "--include", "Smoke", "Tests/"]
      }
    },
    "allowed_operations": ["list", "run"]
  }
]
