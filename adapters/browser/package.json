{
  "name": "workbench-browser-investigations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional disposable browser investigations, separate from business test engines",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "check": "node browser.mjs doctor",
    "smoke:chromium": "node browser.mjs smoke --browser chromium",
    "smoke:edge": "node browser.mjs smoke --browser msedge",
    "test": "node --test bundle.test.mjs"
  },
  "dependencies": { "playwright": "1.64.1" }
}
