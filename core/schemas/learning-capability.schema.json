{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sdlc-workbench:learning-capability:1",
  "title": "Workbench capability revision",
  "description": "A revision of scoped guidance and references. Required permissions describe prerequisites.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "revision", "name", "description", "category", "owner", "risk", "status",
    "scope", "rules", "skills", "contracts", "dependencies", "preconditions", "permissions", "triggers"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "name": { "$ref": "#/$defs/label" },
    "description": { "$ref": "#/$defs/text" },
    "category": {
      "enum": ["system-knowledge", "contract", "business-rule", "workflow", "experience"]
    },
    "owner": { "$ref": "#/$defs/label" },
    "risk": { "enum": ["read-only", "protected"] },
    "status": { "enum": ["ACTIVE", "DEPRECATED"] },
    "scope": { "$ref": "#/$defs/scope" },
    "task": { "$ref": "#/$defs/path" },
    "rules": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/rule" }
    },
    "skills": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/slug" }
    },
    "contracts": { "$ref": "#/$defs/catalog_ids" },
    "dependencies": { "$ref": "#/$defs/catalog_ids" },
    "preconditions": { "$ref": "#/$defs/statements" },
    "permissions": { "$ref": "#/$defs/statements" },
    "triggers": { "$ref": "#/$defs/statements" },
    "previous": { "$ref": "#/$defs/digest" },
    "change_id": { "$ref": "#/$defs/digest" },
    "rollback_of": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f-\\u009f]+(?![\\s\\S])",
      "maxLength": 512
    },
    "label": { "$ref": "#/$defs/text", "maxLength": 128 },
    "statements": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}(?![\\s\\S])" },
    "slug": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])" },
    "catalog_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}(?![\\s\\S])" }
    },
    "scope": {
      "type": "object",
      "description": "Every declared selector must match. An empty selector object has global scope.",
      "additionalProperties": false,
      "properties": {
        "system": { "$ref": "#/$defs/label" },
        "instance": { "$ref": "#/$defs/label" },
        "environment": { "$ref": "#/$defs/label" },
        "repository": { "$ref": "#/$defs/label" },
        "service": { "$ref": "#/$defs/label" },
        "pipeline": { "$ref": "#/$defs/label" },
        "version": { "$ref": "#/$defs/label" },
        "project": { "$ref": "#/$defs/label" },
        "branch": { "$ref": "#/$defs/text" }
      }
    },
    "path": {
      "description": "Workspace-relative file path with forward slashes.",
      "type": "string",
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\u0000-\\u001f\\u007f-\\u009f:\\\\]+(?<!/)(?![\\s\\S])"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "locator"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/digest" },
        "locator": { "$ref": "#/$defs/text" }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "scope", "evidence", "discovery_id"],
      "properties": {
        "key": { "$ref": "#/$defs/slug" },
        "value": { "$ref": "#/$defs/text" },
        "scope": { "$ref": "#/$defs/scope" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "discovery_id": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
