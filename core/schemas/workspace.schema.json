{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local AI-SDLC workspace",
  "type": "object",
  "required": ["schema_version", "id", "name", "resources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 3600},
    "settings": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "auto_commit_staged_changes": {
          "type": "boolean", "default": true,
          "description": "Commit reviewed task-owned staged changes after required checks pass. Agents follow this policy; the runtime does not commit."
        },
        "commit_message_style": {
          "type": "string", "enum": ["plain", "conventional"], "default": "plain",
          "description": "Use a descriptive free-form subject, or require a Conventional Commit subject."
        },
        "commit_granularity": {
          "type": "string", "enum": ["per_stage", "per_task"], "default": "per_stage",
          "description": "When automatic commits are enabled, commit after each completed stage or after the whole task completes."
        },
        "branch_prefix": {
          "type": "string", "minLength": 1, "maxLength": 80, "default": "feature/",
          "description": "Prefix for an authorized new branch. Validate the complete branch name before creating it."
        },
        "ponytail_mode": {
          "type": "string", "enum": ["lite", "full", "ultra", "off"], "default": "full",
          "description": "Select the Ponytail coding style; off disables that style without waiving project requirements."
        },
        "report_verbosity": {
          "type": "string", "enum": ["concise", "standard", "detailed"], "default": "standard",
          "description": "Select report detail while retaining required evidence, findings, risks, and limits."
        }
      }
    },
    "plugins": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "registries": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repositories": {"type": "string", "minLength": 1},
        "services": {"type": "string", "minLength": 1},
        "capabilities": {"type": "string", "minLength": 1},
        "contracts": {"type": "string", "minLength": 1},
        "sources": {"type": "string", "minLength": 1},
        "tools": {"type": "string", "minLength": 1}
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "provider", "environment", "config", "allowed_operations"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "kind": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "config": {"type": "object"},
          "allowed_operations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
