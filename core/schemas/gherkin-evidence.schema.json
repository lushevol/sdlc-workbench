{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI Gherkin evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "evidence", "scenarios"],
  "properties": {
    "version": {"const": 1},
    "evidence": {"type": "object", "additionalProperties": {"$ref": "#/$defs/evidence"}},
    "scenarios": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "start_line", "end_line", "kind", "authority"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"},
        "start_line": {"type": "integer", "minimum": 1}, "end_line": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["ui", "behavior", "automation"]},
        "authority": {"enum": ["approved", "established", "draft", "unknown"]},
        "revision": {"$ref": "#/$defs/text"}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["state", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "state": {"enum": ["PASS", "UNVERIFIED"]}, "reviewer": {"type": ["string", "null"], "minLength": 1, "pattern": "\\S"},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}, "notes": {"$ref": "#/$defs/text"}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "identity", "identity_kind", "scope", "evidence"],
      "properties": {
        "type": {"$ref": "#/$defs/text"}, "identity": {"$ref": "#/$defs/text"},
        "identity_kind": {"enum": ["accessible_name", "visible_label", "test_id", "stable_identifier"]},
        "scope": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/refs"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false, "required": ["kind", "evidence"],
      "properties": {
        "kind": {"enum": ["condition", "interaction", "event", "assertion"]},
        "components": {"$ref": "#/$defs/refs"}, "evidence": {"$ref": "#/$defs/refs"},
        "observation": {"enum": ["ui", "functional"]}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["symbol", "evidence"],
      "properties": {"symbol": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/refs"}}
    },
    "automation": {
      "type": "object", "additionalProperties": false, "required": ["framework", "mode", "bindings", "review"],
      "properties": {
        "framework": {"$ref": "#/$defs/text"}, "mode": {"enum": ["mapped", "native"]},
        "bindings": {"type": "object", "patternProperties": {"^[1-9][0-9]*$": {"$ref": "#/$defs/binding"}}, "additionalProperties": false},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false,
      "required": ["file", "sha256", "behavior", "components", "steps", "review"],
      "properties": {
        "file": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"},
        "behavior": {
          "type": "object", "additionalProperties": false, "required": ["intent", "requirement", "criterion"],
          "properties": {"intent": {"$ref": "#/$defs/text"}, "requirement": {"$ref": "#/$defs/text"}, "criterion": {"$ref": "#/$defs/text"}}
        },
        "components": {"type": "object", "additionalProperties": {"$ref": "#/$defs/component"}},
        "steps": {"type": "object", "patternProperties": {"^[1-9][0-9]*$": {"$ref": "#/$defs/step"}}, "additionalProperties": false},
        "review": {"$ref": "#/$defs/review"}, "automation": {"$ref": "#/$defs/automation"}
      }
    }
  }
}
