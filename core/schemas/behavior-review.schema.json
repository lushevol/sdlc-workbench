{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "baseline_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "story_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "behaviors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/behavior"
      },
      "minItems": 1,
      "maxItems": 4096
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "executions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/execution"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "schema_version",
    "baseline_id",
    "story_id",
    "scope",
    "artifacts",
    "behaviors",
    "links",
    "executions",
    "findings",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-sdlc-workbench:behavior-review:1",
  "title": "Workbench behavior evidence review; no business verification verdict",
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "artifact_id",
        "record_sha256",
        "start_line",
        "end_line"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "kind": {
          "enum": [
            "INTENT",
            "CODE",
            "TEST",
            "EXECUTION"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "repository_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "source_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "sha256"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "CODE"
              }
            }
          },
          "then": {
            "required": [
              "repository_id",
              "revision",
              "source_path"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "repository_id"
                ]
              },
              {
                "required": [
                  "revision"
                ]
              },
              {
                "required": [
                  "source_path"
                ]
              }
            ]
          },
          "then": {
            "required": [
              "repository_id",
              "revision",
              "source_path"
            ]
          }
        }
      ]
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "criterion_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "state": {
          "enum": [
            "ACTIVE",
            "RETIRED"
          ]
        },
        "intent": {
          "$ref": "#/$defs/locator"
        },
        "given": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^Given\\s"
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^When\\s"
        },
        "then": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^Then\\s"
        },
        "measure": {
          "$ref": "#/$defs/measure"
        },
        "negative_cases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 4096
        },
        "required_level": {
          "enum": [
            "UNIT",
            "INTEGRATION",
            "SYSTEM"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "criterion_id",
        "state",
        "intent",
        "given",
        "when",
        "then",
        "measure",
        "negative_cases",
        "required_level"
      ]
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "behavior_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "behavior_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "artifact_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "relationship": {
          "enum": [
            "IMPLEMENTED_BY",
            "ASSERTED_BY"
          ]
        },
        "grade": {
          "enum": [
            "CONFIRMED",
            "LIKELY",
            "POSSIBLE",
            "UNRESOLVED"
          ]
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "assertion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "behavior_id",
        "behavior_record_sha256",
        "artifact_id",
        "artifact_record_sha256",
        "relationship",
        "grade",
        "start_line",
        "end_line",
        "limitations"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "relationship": {
                "const": "ASSERTED_BY"
              }
            }
          },
          "then": {
            "required": [
              "assertion"
            ]
          }
        }
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "link_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "link_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "check_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "link_id",
        "link_record_sha256",
        "check_name"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "artifact_record_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "code_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
          },
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true
        },
        "assertion_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "mode": {
          "enum": [
            "CONTROLLED_SOURCE",
            "SIMULATION",
            "ACTUAL_IMPLEMENTATION"
          ]
        },
        "level": {
          "enum": [
            "UNIT",
            "INTEGRATION",
            "SYSTEM"
          ]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 4096
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 1,
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "artifact_id",
        "artifact_record_sha256",
        "code_artifact_ids",
        "assertion_bindings",
        "mode",
        "level",
        "environment",
        "command",
        "limitations"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "behavior_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
        },
        "kind": {
          "enum": [
            "REQUIREMENT_GAP",
            "IMPLEMENTATION_GAP",
            "ASSERTION_GAP",
            "EXECUTION_GAP",
            "TRACEABILITY_GAP"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "consequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "next_action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{0,159}$"
          },
          "minItems": 0,
          "maxItems": 4096,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "behavior_id",
        "kind",
        "summary",
        "consequence",
        "owner",
        "next_action",
        "evidence_ids"
      ]
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "operator": {
          "enum": [
            "equals",
            "at_least",
            "at_most",
            "less_than",
            "greater_than"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "metric",
        "operator",
        "value",
        "unit"
      ]
    }
  }
}
