{
  "name": "@sc-node-mcp/ado-upload-app",
  "version": "1.7.11",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "MCP App for uploading files to Azure DevOps work items via an embedded UI panel",
  "type": "module",
  "main": "src/server/server.js",
  "exports": {
    ".": "./src/tools.js",
    "./server": "./src/server/server.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://artifactory.global.standardchartered.com/artifactory/api/npm/npm-release"
  },
  "scripts": {
    "build": "vite build && cp src/tools.js dist/ && cp -r src/server dist/",
    "clean": "rm -rf dist",
    "start": "node src/server/server.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sc-node-mcp/core": "^2.16.1",
    "azure-devops-node-api": "^15.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.4",
    "jsdom": "^25.0.0",
    "vite": "^5.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^4.1.4"
  },
  "keywords": [
    "mcp",
    "azure-devops",
    "ado",
    "work-items",
    "file-upload",
    "mcp-app"
  ],
  "author": "",
  "license": "ISC"
}
