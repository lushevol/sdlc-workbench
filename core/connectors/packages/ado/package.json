{
  "name": "@sc-node-mcp/ado",
  "version": "3.4.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Azure DevOps MCP Server - Work Items, Repositories, and PR Review",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "sc-node-mcp-ado": "src/index.js"
  },
  "files": [
    "src/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://artifactory.global.standardchartered.com/artifactory/api/npm/npm-release"
  },
  "exports": {
    ".": "./src/index.js",
    "./connection": "./src/connection.js",
    "./tools": "./src/tools.js",
    "./prompts": "./src/prompts.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@sc-node-mcp/ado-core": "^1.2.11",
    "@sc-node-mcp/ado-pipelines": "^1.4.3",
    "@sc-node-mcp/ado-repos-read": "^1.2.11",
    "@sc-node-mcp/ado-repos-write": "^1.3.11",
    "@sc-node-mcp/ado-review": "^1.3.11",
    "@sc-node-mcp/ado-search": "^1.3.11",
    "@sc-node-mcp/ado-sprints": "^1.3.11",
    "@sc-node-mcp/ado-testplans": "^1.3.11",
    "@sc-node-mcp/ado-workitems-read": "^1.4.3",
    "@sc-node-mcp/ado-workitems-write": "^1.3.11",
    "@sc-node-mcp/core": "^2.16.1",
    "azure-devops-node-api": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@vitest/coverage-v8": "^4.1.4",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "build": "rm -rf dist && cp -r src dist && rm -rf dist/tempRepos",
    "clean": "rm -rf dist",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "azure-devops",
    "ado",
    "work-items",
    "repositories"
  ],
  "author": "",
  "license": "ISC"
}
