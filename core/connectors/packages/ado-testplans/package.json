{
  "name": "@sc-node-mcp/ado-testplans",
  "version": "1.3.11",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "Azure DevOps test plans tools MCP server",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "sc-node-mcp-ado-testplans": "src/index.js"
  },
  "files": [
    "src/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://artifactory.global.standardchartered.com/artifactory/api/npm/npm-release"
  },
  "exports": {
    ".": "./src/index.js",
    "./tools": "./src/tools.js",
    "./prompts": "./src/prompts.js"
  },
  "scripts": {
    "build": "rm -rf dist && cp -r src dist",
    "clean": "rm -rf dist",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "azure-devops",
    "test-plans",
    "standard-chartered"
  ],
  "author": "Standard Chartered",
  "license": "ISC",
  "dependencies": {
    "@sc-node-mcp/ado-core": "^1.2.11",
    "@sc-node-mcp/core": "^2.16.1",
    "azure-devops-node-api": "^15.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sc-node-mcp/shared-tests": "^2.10.3",
    "@vitest/coverage-v8": "^4.1.4",
    "vitest": "^4.1.4"
  }
}
