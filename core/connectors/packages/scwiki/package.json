{
  "name": "@sc-node-mcp/scwiki",
  "version": "1.1.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "SC Wiki (XWiki) MCP Server - Bearer Token Auth",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "sc-node-mcp-scwiki": "src/index.js"
  },
  "files": [
    "src/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://artifactory.global.standardchartered.com/artifactory/api/npm/npm-release"
  },
  "exports": {
    ".": "./src/index.js",
    "./tools": "./src/tools.js",
    "./prompts": "./src/prompts.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@sc-node-mcp/ado-core": "^1.2.11",
    "@sc-node-mcp/core": "^2.16.1",
    "axios": "^1.11.0",
    "https-proxy-agent": "^7.0.6",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@sc-node-mcp/shared-tests": "^2.10.3",
    "@types/node": "^22.14.1",
    "@vitest/coverage-v8": "^4.1.4",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "build": "rm -rf dist && cp -r src dist",
    "clean": "rm -rf dist",
    "start": "node src/index.js",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "scwiki",
    "xwiki",
    "documentation",
    "standard-chartered"
  ],
  "author": "Standard Chartered",
  "license": "ISC"
}
