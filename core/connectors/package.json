{
  "name": "sc-node-mcp",
  "version": "2.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "MCP Server for Azure DevOps and Confluence - Monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "axios": "1.18.0",
    "azure-devops-node-api": "^15.1.0",
    "dotenv": "^17.2.0",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.14.1",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9.18.0",
    "eslint-plugin-security": "^3.0.1",
    "lerna": "^9.0.7",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "scripts": {
    "dev": "npx @modelcontextprotocol/inspector node packages/unified/src/index.js",
    "build": "lerna run build",
    "post-build": "node scripts/post-build.js",
    "test": "lerna run test",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "lerna run test:coverage",
    "lint": "eslint .",
    "clean": "lerna clean -y && rm -rf node_modules && lerna run clean",
    "bootstrap": "lerna bootstrap",
    "release": "node scripts/release.js",
    "publish": "lerna publish",
    "audit": "yarn audit --level high || echo '[audit] yarn audit reported issues above (non-blocking) — see CI log'",
    "update-readme": "node scripts/update-readme.js",
    "update-contributing": "node scripts/update-contributing.js",
    "update-contributors": "node scripts/update-contributors.js",
    "docs": "npm run update-readme && npm run update-contributing && npm run update-contributors",
    "pre-pr": "npm run docs && npm run lint && npm run test",
    "telemetry": "node scripts/telemetry.js",
    "telemetry:users": "node scripts/telemetry.js --users"
  },
  "copilot": {
    "contextFiles": [
      "packages/ado/src/copilot-refactor-instructions-js.md",
      "packages/ado/src/copilot-refactor-instructions-java.md",
      ".github/copilot-instructions.md"
    ],
    "enforceInstructions": true,
    "autoReview": true
  },
  "author": "",
  "license": "ISC",
  "resolutions": {
    "@zkochan/js-yaml": "0.0.11",
    "form-data": "^4.0.6",
    "follow-redirects": "^1.16.0",
    "ip-address": "^10.3.1",
    "body-parser": "^2.3.0",
    "qs": "^6.15.2"
  }
}
