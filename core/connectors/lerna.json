{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "independent",
  "npmClient": "yarn",
  "packages": [
    "packages/*"
  ],
  "command": {
    "version": {
      "message": "chore(release): publish",
      "conventionalCommits": true
    },
    "publish": {
      "registry": "https://artifactory.global.standardchartered.com/artifactory/api/npm/npm-release"
    }
  }
}
