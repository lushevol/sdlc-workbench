{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["packages/**/src/**/*.js", "src/**/*.js"],
  "exclude": ["node_modules", "**/coverage/**", "**/reports/**"]
}
