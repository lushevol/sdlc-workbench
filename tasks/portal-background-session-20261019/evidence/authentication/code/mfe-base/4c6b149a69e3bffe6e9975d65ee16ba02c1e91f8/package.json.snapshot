{
  "name": "@fm/base-origin",
  "version": "0.0.0",
  "scripts": {
    "preinstall": "npx npm-force-resolutions",
    "start": "env-cmd -f .env.local webpack serve",
    "storybook": "storybook dev -p 6006",
    "start:standalone": "webpack serve --env standalone",
    "build": "concurrently npm:build:*",
    "build:webpack": "env-cmd -f .env.server webpack --mode=production",
    "build:types": "tsc",
    "build:server": "env-cmd -f .env.server tsc --project ./server",
    "build:storybook": "storybook build -o dist/storybook",
    "analyze": "webpack --mode=production --env analyze",
    "lint": "eslint src --ext js,ts,tsx --fix",
    "format": "prettier --write ./src",
    "check-format": "prettier --check ./src",
    "test": "cross-env BABEL_ENV=test jest --coverage --ci",
    "test:maxworker": "cross-env BABEL_ENV=test jest --coverage --ci --maxWorkers=4",
    "watch-tests": "cross-env BABEL_ENV=test jest --watch",
    "_prepare": "husky install",
    "coverage": "cross-env BABEL_ENV=test jest --coverage",
    "pre-commit": "prettier --write ./src",
    "post-commit": "pretty-quick --staged",
    "pre-push": "concurrently npm:test npm:lint",
    "ansible-deploy": "node ansible/ansible.js"
  },
  "resolutions": {
    "webpack": "5.76.0",
    "follow-redirects": "1.15.6",
    "glob": "10.3.10",
    "ws": "7.5.11"
  },
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/eslint-parser": "^7.15.0",
    "@babel/plugin-transform-runtime": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@babel/preset-react": "^7.14.5",
    "@babel/preset-typescript": "^7.15.0",
    "@babel/runtime": "^7.15.3",
    "@storybook/addon-a11y": "^7.0.22",
    "@storybook/addon-actions": "^7.0.21",
    "@storybook/addon-essentials": "^7.0.21",
    "@storybook/addon-interactions": "^7.0.21",
    "@storybook/addon-links": "^7.0.21",
    "@storybook/addon-mdx-gfm": "^7.0.21",
    "@storybook/addon-storysource": "^7.0.22",
    "@storybook/addon-styling": "^1.3.0",
    "@storybook/blocks": "^7.0.21",
    "@storybook/react": "^7.0.21",
    "@storybook/react-webpack5": "^7.0.21",
    "@storybook/testing-library": "^0.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/dompurify": "^3.0.5",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.3",
    "@types/openfin": "^51.0.6",
    "@types/react": "^18.0.25",
    "@types/react-dom": "^18.0.8",
    "@types/systemjs": "^6.1.1",
    "@types/testing-library__jest-dom": "^5.14.1",
    "@types/webpack-env": "^1.16.2",
    "babel-jest": "^29.0.3",
    "babel-loader": "^8.2.5",
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "dotenv-webpack": "^8.0.1",
    "env-cmd": "^10.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-ts-react-important-stuff": "^3.0.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.6.12",
    "find-up": "^7.0.0",
    "husky": "^7.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.0.3",
    "jest-cli": "^29.0.3",
    "jest-environment-jsdom": "^29.0.3",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16",
    "prettier": "^2.3.2",
    "pretty-quick": "^3.1.1",
    "storybook": "^7.0.21",
    "text-encoding": "^0.7.0",
    "ts-config-single-spa": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.8.0",
    "webpack-config-single-spa-react": "^4.0.0",
    "webpack-config-single-spa-react-ts": "^4.0.0",
    "webpack-config-single-spa-ts": "^4.0.0",
    "webpack-dev-server": "^4.0.0",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@emotion/css": "^11.11.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@mui/x-data-grid": "^6.18.7",
    "@mui/x-date-pickers-pro": "^6.18.7",
    "@openfin/core": "^35.79.5",
    "@scdevkit/webkit": "*",
    "axios": "^1.8.2",
    "buffer": "^6.0.3",
    "clsx": "^2.0.0",
    "dayjs": "^1.11.9",
    "dompurify": "^3.4.12",
    "event-source-polyfill": "^1.0.31",
    "fdc3-2.1": "npm:@finos/fdc3@2.1.x",
    "moment": "^2.29.4",
    "openfin-fdc3": "^0.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-draggable": "^4.4.5",
    "react-router-dom": "^6.4.4",
    "single-spa": "^5.9.3",
    "single-spa-react": "^5.0.1",
    "uuid": "^9.0.0",
    "zod": "^3.25.76"
  },
  "types": "dist/fm-base.d.ts"
}
