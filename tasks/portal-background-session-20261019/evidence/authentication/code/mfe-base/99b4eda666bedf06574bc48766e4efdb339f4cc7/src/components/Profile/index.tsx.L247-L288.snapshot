              <Stack
                direction="row"
                spacing={1}
                alignItems="center"
                flexWrap="wrap"
              >
                <Typography
                  variant="subtitle1"
                  color="text.secondary"
                  component="span"
                >
                  Login time:
                </Typography>
                <Typography
                  variant="subtitle1"
                  color="text.secondary"
                  component="span"
                >
                  {DateTimeFormat(timeType, auth_time)}
                </Typography>
              </Stack>
              <Stack
                direction="row"
                spacing={1}
                alignItems="center"
                flexWrap="wrap"
              >
                <Typography
                  variant="subtitle1"
                  color="text.secondary"
                  component="span"
                >
                  Session Expired time:
                </Typography>
                <Typography
                  variant="subtitle1"
                  color="text.secondary"
                  component="span"
                >
                  {DateTimeFormat(timeType, expiredIn)}
                </Typography>
              </Stack>
