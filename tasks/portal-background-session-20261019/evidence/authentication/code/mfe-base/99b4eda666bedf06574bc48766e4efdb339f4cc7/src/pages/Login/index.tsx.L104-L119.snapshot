                    <Button
                      size="large"
                      variant="contained"
                      onClick={onLoginUserNamePassword}
                      fullWidth
                      className={classes.button}
                      data-testid={`${PREFIX}_login`}
                      loading={loading}
                    >
                      Sign In
                    </Button>
                    <Divider className={classes.divider} />
                  </section>
                </>
              ) : (
                <></>
