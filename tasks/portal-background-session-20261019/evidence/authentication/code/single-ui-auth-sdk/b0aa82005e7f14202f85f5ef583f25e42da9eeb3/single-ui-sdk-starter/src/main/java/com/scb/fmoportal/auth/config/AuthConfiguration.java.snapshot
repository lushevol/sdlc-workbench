package com.scb.fmoportal.auth.config;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.scb.fmoportal.auth.filter.AuthTokenFilter;
import com.scb.fmoportal.auth.filter.RestExceptionHandler;
import com.scb.fmoportal.auth.properties.AuthProperties;
import com.scb.fmoportal.auth.services.AuthorizationService;
import com.scb.fmoportal.auth.services.implementation.AuthorizationImpl;
import com.scb.fmoportal.auth.util.JwtTokenUtil;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
import org.springframework.boot.restclient.RestTemplateBuilder;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.web.client.RestTemplate;

import java.util.concurrent.CopyOnWriteArrayList;

@Configuration
@ConditionalOnProperty(prefix = "fmoportal.auth", value = "enabled", havingValue = "true", matchIfMissing = true)
public class AuthConfiguration {

    @Autowired
    private AuthProperties authProperties;

    @Autowired
    private ObjectMapper objectMapper;

    @Bean
    public AuthTokenFilter buildSingleUIAuthTokenFilter(JwtTokenUtil jwtTokenUtil) {
        return new AuthTokenFilter(new CopyOnWriteArrayList<>(), authProperties, objectMapper, jwtTokenUtil);
    }

    @Bean
    public RestExceptionHandler buildRestExceptionHandler() {
        return new RestExceptionHandler();
    }

    @Bean
    public AuthorizationService buildAuthorizationService(RestTemplateBuilder builder) {
        RestTemplate restTemplate = builder
            .connectTimeout(authProperties.getConnectTimeout())
            .readTimeout(authProperties.getReadTimeout())
            .build();
        return new AuthorizationImpl(restTemplate, objectMapper, authProperties);
    }
}
