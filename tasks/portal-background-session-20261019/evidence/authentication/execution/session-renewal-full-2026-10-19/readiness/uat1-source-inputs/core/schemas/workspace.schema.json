{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local AI-SDLC workspace",
  "type": "object",
  "required": ["schema_version", "id", "name", "resources"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "id": {"type": "string", "minLength": 1, "maxLength": 100},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 300},
    "plugins": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "registries": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "repositories": {"type": "string", "minLength": 1},
        "services": {"type": "string", "minLength": 1},
        "capabilities": {"type": "string", "minLength": 1},
        "contracts": {"type": "string", "minLength": 1},
        "sources": {"type": "string", "minLength": 1},
        "tools": {"type": "string", "minLength": 1}
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "provider", "environment", "config", "allowed_operations"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "kind": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "environment": {"type": "string", "minLength": 1},
          "config": {"type": "object"},
          "allowed_operations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
