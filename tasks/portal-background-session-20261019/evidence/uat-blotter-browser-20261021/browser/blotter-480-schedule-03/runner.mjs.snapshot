  record.cleanupCompletedAt = new Date().toISOString(); await save();
}
console.log(JSON.stringify({ output, status: record.status, error: record.error }));
process.exitCode = ['PASSED', 'INSPECTED'].includes(record.status) ? 0 : 1;
