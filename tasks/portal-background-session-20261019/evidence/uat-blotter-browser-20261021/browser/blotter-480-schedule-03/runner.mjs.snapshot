      check('Access popup timer remains pending at final observation', accessTimers.some(item => item.scheduledAt + item.delayMs > final.now && !item.canceledAt && !item.firedAt), { accessTimers, observedAt: final.now });
      check('Refresh expiry timer is identified separately', refreshTimers.length > 0 && refreshTimers.every(item => accessTimers.every(access => access.id !== item.id)), { refreshTimers, refresh: lastRefresh });
