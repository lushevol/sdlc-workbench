        check('Both actual credential lifetimes expire before return', record.measured.returnStarted >= settled.access.exp * 1000 && record.measured.returnStarted >= record.measured.refresh.exp * 1000, { returnStarted: record.measured.returnStarted, accessExpiry: settled.access.exp, refreshExpiry: record.measured.refresh.exp });
