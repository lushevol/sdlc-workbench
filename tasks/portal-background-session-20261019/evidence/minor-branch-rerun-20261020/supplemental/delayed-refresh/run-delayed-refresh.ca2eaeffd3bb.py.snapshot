from pathlib import Path
import os,re,subprocess,json,datetime
root=Path.cwd();base=root/'.workbench/session-minor-rerun-20261020'
source=(root/'.workbench/session-post-change-20261020/bff-fast/runner/local/portalsession/LocalSessionApplication.java').read_text()
env=os.environ.copy()
for field,key in [('USER','SESSION_E2E_USERNAME'),('PASSWORD','SESSION_E2E_PASSWORD')]:
 env[key]=re.search(r'public static final String '+field+r'="([^"]+)"',source).group(1)
identity='minor-delayedRefresh-'+datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S')
log=base/(identity+'.log')
with log.open('w') as stream:
 process=subprocess.run(['node',str(base/'delayed-refresh-runner.mjs'),'delayedRefresh','fast',identity],env=env,stdout=stream,stderr=subprocess.STDOUT)
path=base/'native'/identity/'run.json';record=json.loads(path.read_text()) if path.exists() else {}
print(json.dumps({'id':identity,'status':record.get('status'),'exit_code':process.returncode,'error':record.get('error'),'evidence':str(path)}))
