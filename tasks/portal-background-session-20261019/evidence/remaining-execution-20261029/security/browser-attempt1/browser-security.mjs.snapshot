import fs from 'node:fs/promises';
import path from 'node:path';
import crypto from 'node:crypto';
import {pathToFileURL} from 'node:url';
const root=process.cwd();
const output=path.join(root,'tasks/portal-background-session-20261019/evidence/remaining-execution-20261029/security');
const binding=JSON.parse(await fs.readFile(path.join(output,'../execution-source-binding.json'),'utf8'));
const {chromium}=await import(pathToFileURL(path.join(root,'adapters/browser/node_modules/playwright/index.mjs')));
const hash=x=>crypto.createHash('sha256').update(x).digest('hex');
const jwt=(subject,id,now,lifetime)=>'Bearer e30.'+Buffer.from(JSON.stringify({sub:subject,jti:id,iat:Math.floor(now/1000)-1,exp:Math.floor((now+lifetime)/1000)})).toString('base64url')+'.synthetic';
const ids=['RN-S005','RN-S024','RN-S025','RN-S026','RN-S027','RN-S028','RN-S029','RN-S030','RN-S031','RN-S032','RN-S035','RN-S041','RN-S047'];
const summary={started_at:new Date().toISOString(),revision:binding.revision,runner_sha256:hash(await fs.readFile(new URL(import.meta.url))),results:[],limits:['Actual portal DOM, shared Axios interceptors, React reducers, Timeout controller, and public consumer interfaces execute.','Synthetic access/refresh credentials and identity responses test client control flow. Initial login uses isolated local BFF.','No live account switch, business application records, external HTTPS server, production, or cryptographic browser authorization is established.']};
const browser=await chromium.launch({executablePath:'/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge',headless:true,args:['--disable-background-networking','--disable-component-update','--disable-sync','--disable-edgeupdater','--disable-updater-scheduler']});
summary.browser_version=browser.version();
for(const id of ids){
 const folder=path.join(output,id.toLowerCase());await fs.mkdir(folder,{recursive:true});
 const result={case_id:id,status:'RUNNING',started_at:new Date().toISOString(),revision:binding.revision,assertions:[],observations:{},requests:[],screenshots:[],source_binding:'../../execution-source-binding.json',limits:[...summary.limits]};
 const save=async()=>fs.writeFile(path.join(folder,'result.json'),JSON.stringify(result,null,2)+'\n');
 await save();
 const check=(name,actual,expected)=>{const passed=JSON.stringify(actual)===JSON.stringify(expected);result.assertions.push({name,actual,expected,passed});return passed;};
 const context=await browser.newContext({viewport:{width:1100,height:750}});const page=await context.newPage();page.setDefaultTimeout(15000);
 let loginBody,access,refresh,mode='normal',holdEndpoint,held,heldLogins={},loginHold=false,requestCounter=0;
 const bodyFor=subject=>{const b=JSON.parse(loginBody);if(b.userInfo){const u=JSON.parse(b.userInfo);u.sub=subject;u.id=subject;u.userId=subject;u.fullName=subject;if(u.oud){const oud=JSON.parse(u.oud);oud.fullName=subject;u.oud=JSON.stringify(oud);}b.userInfo=JSON.stringify(u);}return JSON.stringify(b);};
 const fulfill=async(route,subject='A',kind='access',status=200)=>{const now=await page.evaluate(()=>Date.now());const headers={};if(status===200){const value=jwt(subject,id+'-'+kind+'-'+(++requestCounter),now,kind==='refresh'?4*60*60_000:60_000);if(kind==='refresh'){headers['single-ui-refresh']=value;refresh=value;}else{headers['single-ui-authorization']=value;access=value;}}return route.fulfill({status,contentType:'application/json',headers,body:status===200?bodyFor(subject):'{"errorMessage":"Synthetic temporary rejection"}'});};
 const waitHeld=async()=>{for(let i=0;i<100&&!held;i++)await new Promise(r=>setTimeout(r,30));if(!held)throw new Error('Fixture held route not reached');};
 const current=async()=>page.evaluate(()=>{const s=window.__base.Hooks.getHooks().store;const decode=t=>{try{return t?window.__base.CommonUtil.getJWTPayload(t).sub:null;}catch{return 'unreadable';}};return{tokenPresent:!!s.token,refreshPresent:!!s.refreshToken,tokenSubject:decode(s.token),refreshSubject:decode(s.refreshToken),userSubject:s.user?.sub??null,token:s.token,refresh:s.refreshToken,dialog:!!document.querySelector('#timeout-dialog-title'),closures:window.__securityProbe?.closures??0};});
 const start=async(endpoint,name='request')=>page.evaluate(({endpoint,name})=>{window['__'+name]=window.__base.Service.service.get(endpoint).then(r=>({ok:true,data:r.data,epoch:r.config.sessionEpoch})).catch(e=>({ok:false,canceled:e.code==='ERR_CANCELED',errorCode:e.code??null}));},{endpoint,name});
 const login=async(subject,awaitResult=true)=>page.evaluate(({subject,awaitResult})=>{const p=window.__base.Service.postService('/auth/v2/sso/login',{fixtureUser:subject}).then(r=>({ok:true,epoch:r.config.sessionEpoch})).catch(e=>({ok:false,code:e.code??null}));window['__login'+subject]=p;if(awaitResult)return p;},{subject,awaitResult});
 const open=async()=>{const {expiry,now}=await page.evaluate(()=>({expiry:window.__base.Hooks.getHooks().store.expiredIn*1000,now:Date.now()}));await page.clock.fastForward(Math.max(1,expiry-now+1));await page.getByTestId('Extend_Btn').waitFor({state:'visible'});};
 const capture=async()=>{const name='final.png';await page.screenshot({path:path.join(folder,name),mask:[page.locator('[data-testid=Username] input'),page.locator('[data-testid=password] input')]});result.screenshots.push({file:name,sha256:hash(await fs.readFile(path.join(folder,name)))});};
 try{
  await page.clock.install({time:new Date('2026-10-29T01:00:00Z')});
  await page.addInitScript(()=>{window.__securityProbe={closures:0};let visible=false;new MutationObserver(()=>{const v=!!document.querySelector('#timeout-dialog-title')?.getClientRects().length;if(visible&&!v)window.__securityProbe.closures++;visible=v;}).observe(document,{subtree:true,childList:true,attributes:true});});
  await page.route('**/api/security/**',async route=>{const endpoint=new URL(route.request().url()).pathname;if(holdEndpoint===endpoint){held=route;return;}return route.fulfill({status:200,contentType:'application/json',body:'{"result":true}'});});
  await page.route('**/api/auth/v2/sso/*',async route=>{
   const endpoint=new URL(route.request().url()).pathname.split('/').pop();const now=await page.evaluate(()=>Date.now());const item={endpoint,at:now};result.requests.push(item);
   if(endpoint==='login'){
    const data=route.request().postDataJSON();const subject=data.fixtureUser??'A';item.fixture_subject=subject;
    if(!loginBody){const response=await route.fetch();if(response.status()!==200)throw new Error('Initial fixture login rejected');loginBody=await response.text();return fulfill(route,subject);}
    if(loginHold){heldLogins[subject]=route;return;}
    if(mode==='reject-login')return fulfill(route,subject,'access',503);
    return fulfill(route,subject);
   }
   if(endpoint===holdEndpoint){held=route;return;}
   if(endpoint==='refreshtoken'){const subject=(await current()).tokenSubject??'A';return fulfill(route,subject,'refresh');}
   if(endpoint==='relogin'){
    const raw=route.request().headers()['single-ui-refresh'];let subject='none';try{subject=JSON.parse(Buffer.from(raw.split(' ')[1].split('.')[1],'base64url').toString()).sub;}catch{}
    item.refresh_subject=subject;
    if(mode==='expired-renewal'){const token=jwt(subject,id+'-expired',now,-5000);return route.fulfill({status:200,contentType:'application/json',headers:{'single-ui-authorization':token},body:bodyFor(subject)});}
    return fulfill(route,subject);
   }
   if(endpoint==='extend')return route.fulfill({status:200,contentType:'application/json',headers:{'single-ui-authorization':access},body:bodyFor((await current()).tokenSubject??'A')});
   if(endpoint==='validate')return route.fulfill({status:200,contentType:'application/json',headers:{'single-ui-authorization':access},body:bodyFor((await current()).tokenSubject??'A')});
   if(endpoint==='logout')return route.fulfill({status:200,contentType:'application/json',body:'{"result":true}'});
   return route.continue();
  });
  const initialResponse=await page.goto('http://127.0.0.1:8343/?show_normal_login=Y');
  result.observations.document_csp_present=!!initialResponse.headers()['content-security-policy'];
  await page.locator('[data-testid=Username] input').fill(process.env.SESSION_E2E_USERNAME);await page.locator('[data-testid=password] input').fill(process.env.SESSION_E2E_PASSWORD);await page.locator('button[data-testid$="_login"]').click();await page.locator('[aria-label=workspaces]').waitFor({state:'visible'});
  await page.clock.pauseAt(await page.evaluate(()=>Date.now()+100));await page.evaluate(async()=>{window.__base=await System.import('@fm/base');await window.__base.Service.getRefreshToken();});await page.waitForFunction(()=>!!window.__base.Hooks.getHooks().store.refreshToken);
  if(id==='RN-S005'){
   await open();holdEndpoint='relogin';await page.getByTestId('Extend_Btn').click();await waitHeld();await page.getByTestId('Logout_Btn').click();let delivery='delivered';try{await fulfill(held,'A');}catch{delivery='already-aborted';}await page.clock.runFor(1001);await page.waitForFunction(()=>!window.__base.Hooks.getHooks().store.token);const s=await current();check('late success leaves access absent',s.tokenPresent,false);check('late success leaves user absent',s.userSubject,null);result.observations.delivery=delivery;
  }else if(id==='RN-S024'){
   await open();const before=await current();mode='expired-renewal';await page.getByTestId('Extend_Btn').click();await page.waitForFunction(()=>document.querySelector('[data-testid=Extend_Btn]')?.disabled===false);const after=await current();check('malformed success does not close dialog',after.closures,before.closures);check('expired renewal access is not installed',after.token===before.token,true);check('usable refresh permits retry',await page.getByTestId('Extend_Btn').isEnabled(),true);
  }else if(['RN-S025','RN-S026'].includes(id)){
   await page.evaluate(()=>{const {baseDispatch}=window.__base.Hooks.getHooks();baseDispatch({type:window.__base.ActionType.ActionType.SET_REFRESH_TOKEN,data:{refreshToken:undefined}});});holdEndpoint='refreshtoken';await page.evaluate(()=>{window.__acquisition=window.__base.Service.getRefreshToken();});await waitHeld();await login('B');const before=await current();holdEndpoint=undefined;if(id==='RN-S025')await fulfill(held,'A','refresh');else await fulfill(held,'A','access',503);await page.evaluate(()=>window.__acquisition);const after=await current();check('old refresh does not replace B refresh',after.refreshSubject==='A',false);check('current user remains B',after.userSubject,'B');if(id==='RN-S026')check('old rejection preserves B access',after.token,before.token);
  }else if(id==='RN-S027'){
   holdEndpoint='/api/security/held-data';await start(holdEndpoint);await waitHeld();await login('B');await held.fulfill({status:200,contentType:'application/json',body:'{"record":"A_ONLY_RECORD"}'});const outcome=await page.evaluate(()=>window.__request);check('old protected payload rejected',outcome.ok,false);check('old protected response canceled',outcome.canceled,true);check('B workspace does not display A record',await page.getByText('A_ONLY_RECORD',{exact:true}).count(),0);result.observations.protected_result=outcome;result.limits.push('Synthetic protected payload and consumer assertion. No real business application renderer was loaded.');
  }else if(id==='RN-S028'){
   await open();await page.evaluate(()=>{const props=e=>e[Object.keys(e).find(k=>k.startsWith('__reactProps$'))];window.__oldCallbacks={logout:props(document.querySelector('[data-testid=Logout_Btn]')).onClick,extend:props(document.querySelector('[data-testid=Extend_Btn]')).onClick};});await login('B');const before=await current();const epochBefore=await page.evaluate(()=>window.__base.Service.service.get('/api/security/epoch').then(r=>r.config.sessionEpoch));const logoutBefore=result.requests.filter(r=>r.endpoint==='logout').length;await page.evaluate(()=>{window.__oldCallbacks.logout();window.__oldExtend=window.__oldCallbacks.extend();});await page.evaluate(()=>window.__oldExtend);await page.clock.runFor(1001);const after=await current();const epochAfter=await page.evaluate(()=>window.__base.Service.service.get('/api/security/epoch').then(r=>r.config.sessionEpoch));check('old callbacks preserve B generation',epochAfter,epochBefore);check('old logout creates no B logout request',result.requests.filter(r=>r.endpoint==='logout').length,logoutBefore);check('old callback closes no dialog',after.closures,before.closures);check('B visible identity remains B',after.userSubject,'B');result.observations.retained_callback_invocation='Actual React button onClick callbacks captured before account replacement';
  }else if(id==='RN-S029'){
   const now=await page.evaluate(()=>Date.now());const b=jwt('B',id+'-direct',now,60000);await page.evaluate(token=>window.__base.Hooks.getHooks().baseDispatch({type:window.__base.ActionType.ActionType.SET_TOKEN,data:{token}}),b);const mixed=await current();await page.evaluate(()=>window.__base.Service.relogin());const after=await current();result.observations.mixed_state={access_subject:mixed.tokenSubject,refresh_subject:mixed.refreshSubject,user_subject:mixed.userSubject};result.observations.renewed_state={access_subject:after.tokenSubject,refresh_subject:after.refreshSubject,user_subject:after.userSubject};check('retained refresh subject recorded',typeof mixed.refreshSubject,'string');check('renewed and visible user subjects recorded',typeof after.tokenSubject==='string'&&typeof after.userSubject==='string',true);result.limits.push('Public dispatcher invocation is the declared external-caller fixture. No deployed direct-token caller is established.');
  }else if(id==='RN-S030'){
   loginHold=true;await login('A',false);await login('B',false);for(let i=0;i<100&&(!heldLogins.A||!heldLogins.B);i++)await new Promise(r=>setTimeout(r,30));if(!heldLogins.A||!heldLogins.B)throw new Error('Both concurrent login routes not reached');await fulfill(heldLogins.B,'B');await page.evaluate(()=>window.__loginB);await fulfill(heldLogins.A,'A');await page.evaluate(()=>window.__loginA);const s=await current();check('later selected B generation survives old A success',s.tokenSubject,'B');check('access and visible user subjects agree',s.userSubject,s.tokenSubject);
  }else if(id==='RN-S031'){
   loginHold=true;await login('B',false);for(let i=0;i<100&&!heldLogins.B;i++)await new Promise(r=>setTimeout(r,30));holdEndpoint='/api/security/transition-data';await start(holdEndpoint);await waitHeld();const h=held.request().headers();let authSubject='none';try{authSubject=JSON.parse(Buffer.from(h['single-ui-authorization'].split(' ')[1].split('.')[1],'base64url').toString()).sub;}catch{}result.observations.transition_request={authorization_subject:authSubject,view_subject:(await current()).userSubject};await fulfill(heldLogins.B,'B');await page.evaluate(()=>window.__loginB);await held.fulfill({status:200,contentType:'application/json',body:'{"record":"A_ONLY_TRANSITION"}'});const outcome=await page.evaluate(()=>window.__request);check('generation and authorization subject recorded',typeof authSubject,'string');check('old transition payload is discarded',outcome.ok,false);check('B view has no A protected payload',await page.getByText('A_ONLY_TRANSITION',{exact:true}).count(),0);result.observations.protected_outcome=outcome;result.limits.push('Synthetic protected consumer assertion; no actual financial business view.');
  }else if(id==='RN-S032'){
   mode='reject-login';await login('B');await open();const s=await current();result.observations.current_subjects={access:s.tokenSubject,refresh:s.refreshSubject,user:s.userSubject};result.observations.recovery={dialog:s.dialog,extend_enabled:await page.getByTestId('Extend_Btn').isEnabled(),retained_A_refresh:s.refreshSubject==='A'};check('current access and refresh subjects recorded',Object.keys(result.observations.current_subjects).length,3);check('A renewability recorded',typeof result.observations.recovery.retained_A_refresh,'boolean');
  }else if(id==='RN-S035'){
   let external;await page.route('https://external.invalid/security-capture',async route=>{const h=route.request().headers();external={method:route.request().method(),access_header_present:!!h['single-ui-authorization'],refresh_header_present:!!h['single-ui-refresh'],origin:new URL(route.request().url()).origin};return route.fulfill({status:200,contentType:'application/json',headers:{'Access-Control-Allow-Origin':'*'},body:'{"result":true}'});});await page.evaluate(()=>window.__base.Service.service.get('https://external.invalid/security-capture').catch(()=>undefined));if(!external)throw new Error('External route not reached');result.observations.external_fixture=external;check('external HTTPS fixture receives no portal access header',external.access_header_present,false);check('external HTTPS fixture receives no portal refresh header',external.refresh_header_present,false);result.limits.push('Playwright intercepts the external HTTPS request before transport. No third-party host or credential was contacted.');
  }else if(id==='RN-S041'){
   await open();await page.getByTestId('Logout_Btn').click();await page.clock.runFor(1001);await page.waitForFunction(()=>!window.__base.Hooks.getHooks().store.token);const s=await current();const storage=await page.evaluate(()=>({localAccess:localStorage.getItem('SET_TOKEN'),sessionAccess:sessionStorage.getItem('SET_TOKEN')}));check('shell access absent',s.tokenPresent,false);check('shell refresh absent',s.refreshPresent,false);check('localStorage access absent',storage.localAccess,null);check('sessionStorage access absent',storage.sessionAccess,null);
  }else if(id==='RN-S047'){
   const s=await current();const exposed=await page.evaluate(()=>{const st=window.__base.Hooks.getHooks().store;return{same_origin_localstorage_reads_access:localStorage.getItem('SET_TOKEN')===st.token,same_origin_public_store_reads_access:!!st.token,same_origin_public_store_reads_refresh:!!st.refreshToken,meta_csp_present:!!document.querySelector('meta[http-equiv="Content-Security-Policy"]')}});result.observations.same_origin_exposure=exposed;check('credential accessibility state recorded',Object.keys(exposed).length,4);check('policy header observation recorded',typeof result.observations.document_csp_present,'boolean');result.limits.push('Authorized same-origin diagnostic script, not an XSS exploit. No injection vector, CSP bypass, or theft was tested.');
  }
  await capture();result.status=result.assertions.every(x=>x.passed)?'PASSED':'FAILED';
 }catch(error){result.status=result.assertions.length?'FAILED':'BLOCKED';result.error=String(error.message).replace(/(?:Bearer\s+)?eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+/g,'[TOKEN]');await capture().catch(()=>{});}
 finally{result.completed_at=new Date().toISOString();await save();summary.results.push({case_id:id,status:result.status,assertions:result.assertions.length,result:path.relative(output,path.join(folder,'result.json'))});await fs.writeFile(path.join(output,'browser-execution.json'),JSON.stringify(summary,null,2)+'\n');await context.close();}
}
await browser.close();summary.completed_at=new Date().toISOString();await fs.writeFile(path.join(output,'browser-execution.json'),JSON.stringify(summary,null,2)+'\n');console.log(JSON.stringify(summary.results));
