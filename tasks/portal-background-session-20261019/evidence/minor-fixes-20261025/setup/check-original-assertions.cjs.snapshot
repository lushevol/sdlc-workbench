const prefix=candidate.split('// Task-owned investigation extensions.')[0];
function assertions(text){const ast=parser.parse(text,{sourceType:'script'}),found=[];function visit(node){if(!node||typeof node!=='object')return;if(node.type==='CallExpression'&&((node.callee.type==='MemberExpression'&&node.callee.object.name==='assert')||node.callee.type==='Identifier'&&node.callee.name==='assert'))found.push(text.slice(node.start,node.end));for(const[key,value]of Object.entries(node)){if(['start','end','loc'].includes(key))continue;if(Array.isArray(value))value.forEach(visit);else if(value&&typeof value==='object')visit(value);}}visit(ast);return found;}
const old=assertions(original),now=assertions(prefix),hash=text=>crypto.createHash('sha256').update(text).digest('hex');
const result={checked_at:new Date().toISOString(),original_source_sha256:hash(original),candidate_full_source_sha256:hash(candidate),original_assertions:old.length,candidate_original_scope_assertions:now.length,original_assertion_sha256:hash(JSON.stringify(old)),candidate_assertion_sha256:hash(JSON.stringify(now)),all_original_assertions_unchanged:JSON.stringify(old)===JSON.stringify(now),method:'Babel parser extracts every assert call from original scope, including shared helper assertions. Exact source strings and order must match.',limits:['This establishes unchanged assertion text. Candidate source/result bindings establish execution separately.','The natural helper adds a durable wait checkpoint without changing assertions.']};
fs.writeFileSync(path.join(root,'tasks/portal-background-session-20261019/evidence/minor-fixes-20261025/setup/original-assertion-integrity.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify(result));if(!result.all_original_assertions_unchanged)process.exitCode=1;
