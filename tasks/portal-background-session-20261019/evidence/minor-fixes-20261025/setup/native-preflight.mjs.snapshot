import { chromium } from '../../adapters/browser/node_modules/playwright/index.mjs';
import { spawn, execFileSync } from 'node:child_process';
import fs from 'node:fs/promises';
import path from 'node:path';
const root=process.cwd(),output=path.join(root,'tasks/portal-background-session-20261019/evidence/minor-fixes-20261025/setup/native-preflight-'+Date.now());
await fs.mkdir(output);const profile=path.join(output,'profile');await fs.mkdir(profile);
const args=[`--user-data-dir=${profile}`,'--remote-debugging-port=0','--remote-debugging-address=127.0.0.1','--no-first-run','--no-default-browser-check','--disable-background-networking','--disable-component-update','--disable-sync','--disable-edgeupdater','--disable-updater-scheduler','--disable-features=msForceBrowserSignIn,msEdgeUpdateLaunchServicesPreferredVersion','about:blank'];
const result={startedAt:new Date().toISOString(),status:'STARTING',scope:'Native visibility setup only; no business login or cases',noDefaults:true,visibilityOverride:false,clockOverride:false,args,observations:[]};
try {const consoleState=execFileSync('ioreg',['-l','-n','Root','-d1'],{encoding:'utf8'});result.consoleLocked=/"IOConsoleLocked"\s*=\s*Yes/.test(consoleState);result.consoleLockFieldFound=consoleState.includes('IOConsoleLocked');}catch(error){result.consoleLockCheckError=String(error.message);}
const child=spawn('/Applications/Microsoft Edge.app/Contents/MacOS/Microsoft Edge',args,{stdio:'ignore'});const exited=new Promise(resolve=>child.once('exit',resolve));const sleep=ms=>new Promise(resolve=>setTimeout(resolve,ms));let browser;
try{let port;for(let i=0;i<150;i++){try{port=Number((await fs.readFile(path.join(profile,'DevToolsActivePort'),'utf8')).split('\n')[0])}catch{}if(port>0)break;await sleep(100)}if(!port)throw Error('Native browser did not expose CDP.');
 browser=await chromium.connectOverCDP(`http://127.0.0.1:${port}`,{noDefaults:true});result.browserVersion=browser.version();const context=browser.contexts()[0];const subject=await context.newPage();await subject.goto('data:text/html,<title>Visibility subject</title><p>Subject</p>');await subject.evaluate(()=>{window.nativeEvents=[];document.addEventListener('visibilitychange',()=>window.nativeEvents.push({visibility:document.visibilityState,time:Date.now()}));});const cover=await context.newPage();await cover.goto('data:text/html,<title>Visibility cover</title><p>Cover</p>');await cover.bringToFront();await sleep(400);result.observations.push({phase:'cover-active',subject:await subject.evaluate(()=>document.visibilityState),cover:await cover.evaluate(()=>document.visibilityState)});await subject.bringToFront();await sleep(400);result.observations.push({phase:'subject-active',subject:await subject.evaluate(()=>document.visibilityState),cover:await cover.evaluate(()=>document.visibilityState)});result.events=await subject.evaluate(()=>window.nativeEvents);await subject.screenshot({path:path.join(output,'subject.png')});result.genuineVisibilityVerified=result.observations[0].subject==='hidden'&&result.observations[0].cover==='visible'&&result.observations[1].subject==='visible'&&result.observations[1].cover==='hidden';result.status=result.genuineVisibilityVerified&&!result.consoleLocked?'PASSED':'FAILED';
}catch(error){result.status='FAILED';result.error=String(error.message);}finally{if(browser)await browser.close().catch(()=>{});if(child.exitCode===null&&child.signalCode===null)child.kill('SIGTERM');await Promise.race([exited,sleep(2000)]);if(child.exitCode===null&&child.signalCode===null)child.kill('SIGKILL');await fs.rm(profile,{recursive:true,force:true,maxRetries:10,retryDelay:100}).catch(error=>{result.cleanupError=error.message});result.completedAt=new Date().toISOString();await fs.writeFile(path.join(output,'result.json'),JSON.stringify(result,null,2)+'\n');console.log(JSON.stringify({output,...result}));}
