  "source_claims": [
    {
      "id": "MANUAL-RENEWAL",
      "claim": "The Timeout controller awaits relogin, closes after resolved usable access, preserves retry after rejection, and suppresses duplicate pending calls.",
      "source": "comprehensive-renewal-20261028/sources/c30ed46d9ea5/useController.ts",
      "lines": [
        126,
        158
      ],
      "limit": "Recovery requires a usable refresh deadline; pending acquisition and elapsed-deadline policy remain conditional."
    },
    {
      "id": "RELOGIN-VALIDATION",
      "claim": "The relogin service returns its Axios promise. The success handler rejects absent, expired, or invalid temporal access claims before installing authentication state.",
      "source": [
        "comprehensive-renewal-20261028/sources/12f895009ad5/index.ts",
        "comprehensive-renewal-20261028/sources/33c7f335a174/succes.response.handler.ts"
      ],
      "limit": "Client JWT payload inspection does not establish signature verification or a protected-service authorization."
    },
    {
      "id": "ACTIVITY-GAP",
      "claim": "Committed Home uses a five-second mouse debounce. Repeated mouse events reset its timer. Keyboard and scroll bindings are absent from Home JSX.",
      "source": "comprehensive-renewal-20261028/sources/cf5f6312f3fb/useController.ts",
      "lines": [
        60,
        69
      ],
      "additional_source": "repos/ui/mfe-base@66c6411ade58e4d134e381c2baee8ad3f76a8dbf:src/pages/Home/index.tsx",
      "limit": "Retain continuous activity renewal as intended target; do not describe all three requested activity paths as delivered."
    },
    {
      "id": "REFRESH-ACQUISITION",
      "claim": "Refresh acquisition reuses credentials with more than three hours remaining. It shares an eligible pending request by session epoch and access token.",
      "source": "comprehensive-renewal-20261028/sources/12f895009ad5/index.ts",
      "lines": [
        29,
        105
      ],
      "limit": "The three-hour reuse window is an implementation constant. It is not a new approved business timeout."
    },
    {
      "id": "LIFECYCLE",
      "claim": "Home requests refresh before access expiry and reconciles visibility changes. It replaces expired refresh while access remains usable.",
      "source": "comprehensive-renewal-20261028/sources/cf5f6312f3fb/useController.ts",
      "lines": [
        112,
        209
      ],
      "limit": "Scheduled callbacks and controlled executions do not prove native suspension recovery, full duration, or PROD applicability."
    },
    {
      "id": "SESSION-BOUNDARY",
      "claim": "Session epochs reject obsolete success responses. Logout invalidates the epoch and aborts renewal requests.",
      "source": [
        "comprehensive-renewal-20261028/sources/b524186ae494/sessionEpoch.ts",
        "comprehensive-renewal-20261028/sources/33c7f335a174/succes.response.handler.ts"
      ],
      "limit": "An older unauthorized response within the same epoch can still clear newer credentials. Retained RN-R020 records that controlled observation."
    }
  ],
