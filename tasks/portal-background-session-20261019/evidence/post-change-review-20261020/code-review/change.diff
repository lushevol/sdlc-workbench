+import { AxiosResponse, InternalAxiosRequestConfig } from "axios";
+import type { AxiosAdapter } from "axios";
+import { getHooksBase } from "../../HooksBase";
+import rootReducer from "../../reducer/root.reducers";
+import rootReducer0 from "../../reducer/root0.reducers";
+import service from "../config";
+import { extend, signal } from "./extend";
+
+interface PendingRequest {
+  config: InternalAxiosRequestConfig;
+  resolve: (response: AxiosResponse) => void;
+}
+
+const now = Date.parse("2026-10-20T00:00:00Z");
+const expiresAt = now / 1000 + 900;
+const flush = async () => {
+  for (let step = 0; step < 12; step += 1) await Promise.resolve();
+};
+
+describe("active extension request lifecycle", () => {
+  const hooks = getHooksBase();
+  const originalAdapter = service.defaults.adapter;
+  const originalStore = hooks.store;
+  const originalDispatch = hooks.baseDispatch;
+  let requests: PendingRequest[];
+  let calls: Array<ReturnType<typeof extend>>;
+
+  const complete = (request: PendingRequest, accessToken?: string) =>
+    request.resolve({
+      config: request.config,
+      status: 200,
+      statusText: "OK",
+      headers: accessToken ? { "single-ui-authorization": accessToken } : {},
+      data: { result: true },
+    });
+
+  beforeEach(() => {
+    jest.spyOn(Date, "now").mockReturnValue(now);
+    requests = [];
+    calls = [];
+    hooks.setStore({
+      token: "first-access",
+      expiredIn: expiresAt,
+      workspaces: [],
+    });
+    hooks.setBaseDispatch((action) => {
+      hooks.setStore(rootReducer(rootReducer0(hooks.store, action), action));
+    });
+    const adapter: AxiosAdapter = (config) =>
+      new Promise((resolve) => {
+        requests.push({ config, resolve });
+      });
+    service.defaults.adapter = adapter;
+  });
+
+  afterEach(async () => {
+    signal.extendToken?.abort();
+    requests.forEach((request) => complete(request));
+    await Promise.allSettled(calls);
+    await flush();
+    service.defaults.adapter = originalAdapter;
+    hooks.setStore(originalStore);
+    hooks.setBaseDispatch(originalDispatch);
+    signal.extendToken = undefined;
+    jest.restoreAllMocks();
