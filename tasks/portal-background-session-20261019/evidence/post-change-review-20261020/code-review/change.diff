--- /dev/null
+++ b/src/components/Timeout/renewalCompletion.test.tsx
@@ -0,0 +1,253 @@
+import React from "react";
+import { Buffer } from "buffer";
+import type { AxiosAdapter, InternalAxiosRequestConfig } from "axios";
+import {
+  act,
+  cleanup,
+  fireEvent,
+  render,
+  screen,
+} from "@testing-library/react";
+import Provider from "../../hooks/provider";
+import { getHooksBase } from "../../hooks/HooksBase";
+import service from "../../hooks/service/config";
+import { signal } from "../../hooks/service";
+import Timeout from ".";
+
+const mockModalEvent = jest.fn();
+jest.mock("../../analytics", () => () => ({
+  ButtonEvent: jest.fn(),
+  ModalEvent: mockModalEvent,
+}));
+
+const now = Date.parse("2026-10-20T00:00:00Z");
+const minute = 60_000;
+const token = (subject: string, expiresAt: number) =>
+  `Bearer e30.${Buffer.from(
+    JSON.stringify({ sub: subject, iat: now / 1000, exp: expiresAt / 1000 })
+  ).toString("base64")}.test-signature`;
+const initialAccess = token("initial-access", now - 1);
+const renewedAccess = token("renewed-access", now + 15 * minute);
+const refresh = token("refresh", now + 60 * minute);
+const originalAdapter = service.defaults.adapter;
+
+describe("Manual session renewal completion", () => {
+  let requests: InternalAxiosRequestConfig[];
+  let finishRenewal: () => void;
+  let failRenewal: () => void;
+  let renewalResult: object;
+  let renewalHeader: string | undefined;
+  let setOpen: jest.Mock;
+
+  const relogins = () =>
+    requests.filter(({ url }) => url === "/api/auth/v2/sso/relogin");
+  const successfulClosures = () =>
+    mockModalEvent.mock.calls.filter(([event]) => event === "close");
+  const renderTimeout = async (refreshToken = refresh) => {
+    const rendered = render(
+      <Provider
+        data={{
+          token: initialAccess,
+          refreshToken,
+          expiredIn: (now - 1) / 1000,
+          workspaces: [],
+        }}
+      >
+        <Timeout setOpen={setOpen} />
+      </Provider>
+    );
+    await act(async () => undefined);
+    return rendered;
+  };
+  const clickExtend = async () => {
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Extend" }));
+    });
+  };
+
+  beforeEach(() => {
+    jest.useFakeTimers();
+    jest.setSystemTime(now);
+    localStorage.clear();
+    sessionStorage.clear();
+    mockModalEvent.mockClear();
+    requests = [];
+    setOpen = jest.fn();
+    renewalResult = {};
+    renewalHeader = renewedAccess;
+    const adapter: AxiosAdapter = async (config) => {
+      requests.push(config);
+      if (config.url === "/api/auth/v2/sso/relogin") {
+        await new Promise<void>((resolve, reject) => {
+          finishRenewal = resolve;
+          failRenewal = () =>
+            reject({
+              config,
+              message: "Request failed with status code 503",
+              response: {
+                status: 503,
+                data: { errorMessage: "Renewal unavailable" },
+              },
+            });
+        });
+        return {
+          config,
+          data: renewalResult,
+          headers: renewalHeader
+            ? { "single-ui-authorization": renewalHeader }
+            : {},
+          status: 200,
+          statusText: "OK",
+        };
+      }
+      if (
+        config.url === "/api/auth/v2/sso/logout" ||
+        config.url === "/api/ssiplus/imeta/logout"
+      ) {
+        return { config, data: {}, headers: {}, status: 200, statusText: "OK" };
+      }
+      throw new Error(`Unexpected request: ${config.url}`);
+    };
+    service.defaults.adapter = adapter;
+  });
+
+  afterEach(() => {
+    cleanup();
+    signal.getRefreshToken?.abort();
+    signal.relogin?.abort();
+    signal.getRefreshToken = undefined;
+    signal.relogin = undefined;
+    service.defaults.adapter = originalAdapter;
+    jest.clearAllTimers();
+    jest.useRealTimers();
+    localStorage.clear();
+    sessionStorage.clear();
+  });
+
+  it("keeps the dialog pending, then closes once after valid renewal", async () => {
+    await renderTimeout();
+    await clickExtend();
+    expect(relogins()).toHaveLength(1);
+    expect(relogins()[0].headers["Single-UI-Refresh"]).toBe(refresh);
+    expect(screen.getByRole("button", { name: "Extend" })).toBeDisabled();
+    expect(screen.getByRole("button", { name: "Logout" })).toBeEnabled();
+    expect(setOpen).not.toHaveBeenCalled();
+    expect(successfulClosures()).toHaveLength(0);
+    await clickExtend();
+    expect(relogins()).toHaveLength(1);
+
+    await act(async () => finishRenewal());
+
+    expect(getHooksBase().store.token).toBe(renewedAccess);
+    expect(setOpen).toHaveBeenCalledTimes(1);
+    expect(setOpen).toHaveBeenCalledWith(false);
+    expect(successfulClosures()).toHaveLength(1);
+    await clickExtend();
+    expect(relogins()).toHaveLength(1);
+    await act(async () => jest.advanceTimersByTime(60 * minute));
+    expect(setOpen).toHaveBeenCalledTimes(1);
+  });
+
+  it("keeps the dialog after HTTP rejection and allows a successful retry", async () => {
+    await renderTimeout();
+    await clickExtend();
+    await act(async () => failRenewal());
+
+    expect(setOpen).not.toHaveBeenCalled();
+    expect(successfulClosures()).toHaveLength(0);
+    expect(getHooksBase().store.token).toBe(initialAccess);
+    expect(screen.getByRole("alert")).toHaveTextContent("Please try again");
+    expect(screen.getByRole("button", { name: "Extend" })).toBeEnabled();
+    await clickExtend();
+    expect(relogins()).toHaveLength(2);
+    await act(async () => finishRenewal());
+    expect(getHooksBase().store.token).toBe(renewedAccess);
+    expect(setOpen).toHaveBeenCalledTimes(1);
+  });
+
+  it("rejects a resolved failure without applying its authorization header", async () => {
+    renewalResult = { result: false };
+    await renderTimeout();
+    await clickExtend();
+    await act(async () => finishRenewal());
+
+    expect(getHooksBase().store.token).toBe(initialAccess);
+    expect(setOpen).not.toHaveBeenCalled();
+    expect(successfulClosures()).toHaveLength(0);
+    expect(screen.getByRole("alert")).toBeInTheDocument();
+    expect(screen.getByRole("button", { name: "Extend" })).toBeEnabled();
+  });
+
+  it.each([
+    ["missing", undefined],
+    ["expired", token("expired-response", now - 1)],
+    ["malformed", "Bearer malformed"],
+    [
+      "missing issued-at",
+      `Bearer e30.${Buffer.from(
+        JSON.stringify({ exp: (now + 15 * minute) / 1000 })
+      ).toString("base64")}.test-signature`,
+    ],
+  ])(
+    "does not close or change authorization for a %s renewed token",
+    async (_description, header) => {
+      renewalHeader = header;
+      await renderTimeout();
+      await clickExtend();
+      await act(async () => finishRenewal());
+      expect(setOpen).not.toHaveBeenCalled();
+      expect(getHooksBase().store.token).toBe(initialAccess);
+      expect(screen.getByRole("alert")).toBeInTheDocument();
+      expect(screen.getByRole("button", { name: "Extend" })).toBeEnabled();
+    }
+  );
+
+  it("aborts pending renewal when the user logs out and ignores late success", async () => {
+    await renderTimeout();
+    await clickExtend();
+    await act(async () => {
+      fireEvent.click(screen.getByRole("button", { name: "Logout" }));
+    });
+    expect(relogins()[0].signal?.aborted).toBe(true);
+    await act(async () => finishRenewal());
+    expect(getHooksBase().store.token).toBe(initialAccess);
+    expect(setOpen).not.toHaveBeenCalled();
+    await act(async () => jest.advanceTimersByTime(1000));
+    expect(getHooksBase().store.token).toBeUndefined();
+    expect(setOpen).toHaveBeenCalledTimes(1);
+  });
+
+  it("aborts pending renewal at refresh expiry and ignores late success", async () => {
+    await renderTimeout(token("short-refresh", now + 5000));
+    await clickExtend();
+    await act(async () => jest.advanceTimersByTime(3000));
+    expect(relogins()[0].signal?.aborted).toBe(true);
+    await act(async () => finishRenewal());
+    expect(getHooksBase().store.token).toBe(initialAccess);
+    await act(async () => jest.advanceTimersByTime(1000));
+    expect(getHooksBase().store.token).toBeUndefined();
+    expect(setOpen).toHaveBeenCalledTimes(1);
+  });
+
+  it("aborts pending renewal on unmount without restoring authentication", async () => {
+    const { unmount } = await renderTimeout();
+    await clickExtend();
+    unmount();
+    expect(relogins()[0].signal?.aborted).toBe(true);
+    await act(async () => finishRenewal());
+    expect(getHooksBase().store.token).toBe(initialAccess);
+    expect(setOpen).not.toHaveBeenCalled();
+  });
+
+  it.each(["Bearer malformed", token("expired-refresh", now - 1)])(
+    "logs out safely when refresh credentials are unusable: %s",
+    async (refreshToken) => {
+      await renderTimeout(refreshToken);
+      expect(screen.getByRole("button", { name: "Extend" })).toBeDisabled();
+      expect(relogins()).toHaveLength(0);
+      await act(async () => jest.advanceTimersByTime(1000));
+      expect(getHooksBase().store.token).toBeUndefined();
+      expect(setOpen).toHaveBeenCalledTimes(1);
+    }
+  );
+});
