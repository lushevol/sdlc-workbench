"""Start configured local services, run one native case, and stop every owned process.

No dependency installation, source compilation, browser download, or credential loading occurs.
Commands, working directories, ready URLs, source bindings, and existing builds are explicit inputs.
"""
from pathlib import Path
import argparse
import datetime
import hashlib
import json
import os
import signal
import socket
import subprocess
import sys
import time
import urllib.request


def utc():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def digest(data):
    return hashlib.sha256(data).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--config', required=True)
    parser.add_argument('--browser-config', required=True)
    parser.add_argument('--case', required=True)
    parser.add_argument('--run-id', required=True)
    parser.add_argument('--output', required=True)
    args = parser.parse_args()
    config_file = Path(args.config).resolve()
    config = json.loads(config_file.read_text())
    evidence = Path(args.output).resolve() / (args.run_id + '-stack')
    evidence.mkdir(parents=True, exist_ok=False)
    runtime = Path(config['runtimeDirectory']).resolve() / args.run_id
    runtime.mkdir(parents=True, exist_ok=False)
    services = []
    record = {'startedAt': utc(), 'status': 'STARTING', 'services': [], 'sourceBindings': [],
              'configurationSha256': digest(config_file.read_bytes()), 'startupDownloads': False,
              'limits': config.get('limits', []), 'credentialsRetained': False}

    def save(name, value):
        with (evidence / name).open('x') as stream:
            json.dump(value, stream, indent=2)
            stream.write('\n')

    def stopped(_signal, _frame):
        raise InterruptedError('Local stack interrupted.')

    signal.signal(signal.SIGTERM, stopped)
    signal.signal(signal.SIGINT, stopped)
    browser_code = None
    try:
        save('stack-inputs.json', record)
        (evidence / 'stack-config.json.snapshot').write_bytes(config_file.read_bytes())
        (evidence / 'run-stack.py.snapshot').write_bytes(Path(__file__).read_bytes())
        for item in config.get('sourceBindings', []):
            source = Path(item['path']).resolve()
            data = source.read_bytes()
            if item.get('sha256') and digest(data) != item['sha256']:
                raise ValueError('Source binding changed: ' + item['label'])
            target = 'binding-' + str(len(record['sourceBindings']) + 1).zfill(3) + '-' + source.name
            if item.get('retain', True):
                with (evidence / target).open('xb') as stream:
                    stream.write(data)
            record['sourceBindings'].append({'label': item['label'], 'sha256': digest(data),
                                            'retained': target if item.get('retain', True) else None})
        for service in config['services']:
            for port in service.get('ports', []):
                if port == 8018:
                    raise ValueError('Port8018 is outside this test scope.')
                with socket.socket() as connection:
                    if connection.connect_ex(('127.0.0.1', port)) == 0:
                        raise ValueError('Owned port is already in use: ' + str(port))
        env = os.environ.copy()
        env.update(config.get('environment', {}))
        for service in config['services']:
            local_env = env.copy()
            local_env.update(service.get('environment', {}))
            log = (runtime / (service['name'] + '.log')).open('x')
            process = subprocess.Popen(service['command'], cwd=service['cwd'], env=local_env,
                                       stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
            services.append((service, process, log))
            record['services'].append({'name': service['name'], 'pid': process.pid,
                                       'ports': service.get('ports', []), 'status': 'STARTING'})
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        deadline = time.monotonic() + config.get('startupTimeoutSeconds', 120)
        pending = list(config.get('readyUrls', []))
        while pending and time.monotonic() < deadline:
            if any(process.poll() is not None for _, process, _ in services):
                raise RuntimeError('A configured service exited before readiness.')
            remaining = []
            for url in pending:
                try:
                    with opener.open(url, timeout=2) as response:
                        if response.status != 200:
                            remaining.append(url)
                except Exception:
                    remaining.append(url)
            pending = remaining
            if pending:
                time.sleep(0.5)
        if pending:
            raise RuntimeError('Configured services did not become ready.')
        record['status'] = 'RUNNING'
        record['readyAt'] = utc()
        save('stack-ready.json', record)
        command = [config.get('nodeExecutable', 'node'), str(Path(__file__).with_name('runner.mjs')),
                   '--config', str(Path(args.browser_config).resolve()), '--case', args.case,
                   '--run-id', args.run_id, '--output', str(Path(args.output).resolve())]
        # The browser inherits private credential variables. No credential values enter the command or receipt.
        browser = subprocess.Popen(command, env=env, start_new_session=True)
        record['browserPid'] = browser.pid
        save('browser-started.json', {'startedAt': utc(), 'pid': browser.pid, 'caseId': args.case})
        browser_code = browser.wait()
        record['browserExitCode'] = browser_code
        record['status'] = 'COMPLETE' if browser_code == 0 else 'FAILED'
    except Exception as error:
        record['status'] = 'INTERRUPTED' if isinstance(error, InterruptedError) else 'FAILED'
        record['errorType'] = type(error).__name__
        # Do not include arbitrary child output, environment values or raw HTTP bodies.
        record['error'] = str(error) if isinstance(error, (ValueError, RuntimeError, InterruptedError)) else 'Local stack operation failed.'
    finally:
        if 'browser' in locals() and browser.poll() is None:
            os.killpg(browser.pid, signal.SIGTERM)
            try:
                browser.wait(timeout=8)
            except subprocess.TimeoutExpired:
                os.killpg(browser.pid, signal.SIGKILL)
                browser.wait(timeout=4)
        for service, process, log in reversed(services):
            if process.poll() is None:
                os.killpg(process.pid, signal.SIGTERM)
                try:
                    process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    os.killpg(process.pid, signal.SIGKILL)
                    process.wait(timeout=4)
            log.close()
            data = (runtime / (service['name'] + '.log')).read_bytes()
            metadata = []
            compile_messages = []
            for line in data.decode(errors='replace').splitlines():
                if 'compiled successfully' in line:
                    compile_messages.append(line)
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if isinstance(event, dict) and event.get('event') == 'local_http':
                    row = {key: event[key] for key in ('event', 'started_at', 'method', 'route', 'status', 'elapsed_ms') if key in event}
                    row['issued_tokens'] = {header: {key: value for key, value in token.items() if key in ('sha256', 'iat', 'exp', 'iss', 'auth_time', 'max_age')}
                                            for header, token in event.get('issued_tokens', {}).items() if isinstance(token, dict)}
                    metadata.append(row)
            save(service['name'] + '-log-metadata.json', {'rawLogSha256': digest(data), 'rawLogBytes': len(data),
                 'rawLogRetained': False, 'compileMessages': compile_messages, 'httpMetadata': metadata,
                 'limit': 'SQL and non-JSON service output are excluded. Raw logs remain in the ignored runtime directory.'})
            next(item for item in record['services'] if item['name'] == service['name']).update({'status': 'STOPPED', 'exitCode': process.returncode})
        record['servicesStopped'] = True
        record['finishedAt'] = utc()
        save('stack-result.json', record)
    print(json.dumps({'status': record['status'], 'browserExitCode': browser_code, 'evidence': str(evidence)}))
    return 0 if record['status'] == 'COMPLETE' else 1


if __name__ == '__main__':
    sys.exit(main())
