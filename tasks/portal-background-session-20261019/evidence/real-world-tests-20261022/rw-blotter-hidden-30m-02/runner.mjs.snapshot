const username = process.env[config.usernameEnvironment || 'SESSION_E2E_USERNAME'];
const password = process.env[config.passwordEnvironment || 'SESSION_E2E_PASSWORD'];
const privateValues = [...new Set([username, password, ...(config.redactEnvironmentNames || []).map(name => process.env[name])].filter(Boolean))];
const redactPrivate = value => {
