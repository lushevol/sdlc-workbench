const allowedCases = ['RW-CONFIG-PREFLIGHT', 'RW-480-SCHEDULE', 'RW-BLOTTER-HIDDEN-30M', 'RW-SHORT-IDLE', 'RW-REMOTE-NO-STUBS'];
const args = Object.fromEntries(process.argv.slice(2).reduce((pairs, value, i, all) => {
