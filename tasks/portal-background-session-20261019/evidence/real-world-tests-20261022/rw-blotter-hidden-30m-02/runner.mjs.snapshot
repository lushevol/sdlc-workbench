  const blank = await authenticate();
  const settled = await checkpoint('settled');
  assert.ok(settled.blotterMounted && settled.gridMounted && settled.homeMounted, 'Actual Blotter, grid and Home must mount.');
  assert.ok(!settled.dashboardMounted && settled.populatedWorkspaceCount === 1 && settled.workspaceTiles.every(x => x === '/cashflow_cn'), 'Only the actual Blotter workspace may be populated.');
  assert.ok(settled.access?.exp * 1000 > Date.now(), 'Access must remain valid at measurement start.');
  if (args.case !== 'RW-REMOTE-NO-STUBS' || timing.expectedRefreshLifetimeSeconds !== null) assert.ok(latestRefresh?.exp * 1000 > Date.now(), 'Acquire a real refresh credential before this case.');
  check('actual-blotter', 'Actual Blotter and grid are mounted without another populated workspace', true, { settledCheckpoint: 'settled' });
  await Promise.allSettled(responseTasks);
  if (config.mode === 'local-fixture' || config.requiredModules?.length) {
    const required = config.requiredModules || (config.moduleUrls || []).map(url => ({ url }));
    check('actual-module-responses', 'Every required actual application module was fetched with bytes', required.length > 0 && required.every(expected => record.modulesResponse.some(actual => actual.route === safeUrl(expected.url) && actual.status >= 200 && actual.status < 300 && actual.bytes > 0 && actual.sha256 && (!expected.sha256 || actual.sha256 === expected.sha256))), { required, actual: record.modulesResponse });
    assert.ok(record.assertions.at(-1).passed, 'Required actual module responses were not observed.');
  } else record.moduleIdentity = { status: 'NOT_BOUND', limit: 'Actual response bytes require declared inspected module URLs and deployment binding.' };
  record.timing = evaluateTiming({ profile: timing, accessClaims: settled.access, refreshClaims: latestRefresh, ...settled.runnerClockSample, serviceDates: record.serviceDates, effectiveConfigurationEvidence: config.effectiveConfigurationEvidence || null });
  for (const item of record.timing.checks) check('preflight-' + item.id, 'Timing preflight: ' + item.id, item.status === 'PASSED', item);
  await writeExclusive('timing-preflight.json', record.timing);
  assert.equal(record.timing.status, 'PASSED', 'Actual timing differs from the configured expectation.');
  if (args.case !== 'RW-CONFIG-PREFLIGHT') scheduleAssertions(settled);
  if (args.case === 'RW-CONFIG-PREFLIGHT') {
    record.status = record.assertions.every(x => x.passed) ? 'PASSED' : 'FAILED';
    await checkpoint('preflight-final');
  } else {
  if (args.case === 'RW-480-SCHEDULE') {
    assert.equal(settled.access.exp - settled.access.iat, 28800, 'Expected original480-minute lifetime.');
  }
  const hidden = args.case === 'RW-BLOTTER-HIDDEN-30M' || args.case === 'RW-SHORT-IDLE' || args.case === 'RW-REMOTE-NO-STUBS';
  const observationMs = args.case === 'RW-BLOTTER-HIDDEN-30M' ? 1800000 : (config.observationMs ?? 15000);
  if (hidden) { await blank.bringToFront(); await page.waitForFunction(() => document.visibilityState === 'hidden', null, { timeout: 5000 }); }
  const baseline = await checkpoint(hidden ? 'hidden-baseline' : 'visible-baseline', false);
  const hostStart = Date.now(), monoStart = process.hrtime.bigint();
  const deadline = args.case === 'RW-SHORT-IDLE' ? settled.access.exp * 1000 + (config.expiryGraceMs ?? 5000) : hostStart + observationMs;
  if (args.case === 'RW-BLOTTER-HIDDEN-30M') {
    assert.ok(settled.access.exp * 1000 > deadline + 5000, 'Access expiry must exceed the30-minute observation.');
    assert.ok(latestRefresh.exp * 1000 > deadline + 5000, 'Independent refresh expiry must exceed the30-minute observation.');
  }
  if (args.case === 'RW-SHORT-IDLE') assert.ok(latestRefresh.exp * 1000 > deadline + 5000, 'Refresh must outlive the shortened access boundary.');
  record.status = 'RUNNING'; record.measurement = { hostStart, deadline, requestedMs: deadline - hostStart, baselineAccess: baseline.access, baselineRefresh: latestRefresh, baselineTrustedActivity: baseline.observation.trustedActivity, hidden };
  await writeExclusive('measurement-start.json', { ...record.measurement, sourceBindings: record.sourceBindings, driverSha256: record.driverSha256 });
  await event('MEASUREMENT_STARTED', record.measurement);
  console.log(JSON.stringify({ status: 'RUNNING', caseId: record.caseId, output, deadline: new Date(deadline).toISOString() }));
  await waitReal(deadline, monoStart);
  const beforeReturn = await checkpoint('before-return', false);
  if (args.case === 'RW-480-SCHEDULE' || args.case === 'RW-BLOTTER-HIDDEN-30M') scheduleAssertions(beforeReturn, 'final');
  const hostEnd = Date.now(), elapsedMonotonicMs = Number(process.hrtime.bigint() - monoStart) / 1e6;
  record.measurement.actualWallMs = hostEnd - hostStart; record.measurement.actualMonotonicMs = elapsedMonotonicMs;
  const delta = Object.fromEntries(Object.keys(baseline.observation.trustedActivity).map(k => [k, beforeReturn.observation.trustedActivity[k] - baseline.observation.trustedActivity[k]]));
  const visibilityEvents = beforeReturn.observation.events.filter(x => x.event === 'visibilitychange' && x.time >= baseline.now && x.time <= beforeReturn.now);
  const mainFrameNavigations = record.mainFrameNavigations.filter(x => x.time >= hostStart);
  const replacementEvents = beforeReturn.observation.events.filter(x => ['pageshow', 'pagehide'].includes(x.event) && x.time >= hostStart);
  check('same-document', 'The measured browser document and observation history remain continuous', beforeReturn.timeOrigin === baseline.timeOrigin && mainFrameNavigations.length === 0 && replacementEvents.length === 0, { initialTimeOrigin: baseline.timeOrigin, finalTimeOrigin: beforeReturn.timeOrigin, mainFrameNavigations, replacementEvents });
  check('trusted-input', 'No trusted mouse, keyboard or scroll input occurs during measurement', Object.values(delta).every(x => x === 0), { delta, baseline: baseline.observation.trustedActivity, final: beforeReturn.observation.trustedActivity });
  check('real-clock', 'Wall and host monotonic elapsed times agree within two seconds', Math.abs(record.measurement.actualWallMs - elapsedMonotonicMs) <= 2000, { wallMs: record.measurement.actualWallMs, monotonicMs: elapsedMonotonicMs, toleranceMs: 2000 });
  if (hidden) check('native-hidden', 'The native page stays hidden throughout measurement', baseline.visibility === 'hidden' && beforeReturn.visibility === 'hidden' && visibilityEvents.every(x => x.visibility === 'hidden'), { baselineVisibility: baseline.visibility, finalVisibility: beforeReturn.visibility, visibilityEvents });
  const opened = beforeReturn.observation.events.filter(x => x.event === 'timeout_opened' && x.time >= baseline.now);
  const extensions = movingExtensions(hostStart, baseline.access.exp);
  if (args.case !== 'RW-REMOTE-NO-STUBS') check('fixed-expiry', 'No successful extension changes settled access expiry', extensions.length === 0 && beforeReturn.access?.exp === baseline.access.exp, { extensions, baselineAccess: baseline.access, finalAccess: beforeReturn.access });
  if (args.case === 'RW-SHORT-IDLE') {
    check('timeout-at-expiry', 'Timeout opens after actual shortened access expiry', opened.some(x => x.time >= baseline.access.exp * 1000) && beforeReturn.timeoutVisible, { opened, expectedExpiry: baseline.access.exp, timeoutVisible: beforeReturn.timeoutVisible });
  } else if (args.case === 'RW-BLOTTER-HIDDEN-30M' || args.case === 'RW-480-SCHEDULE') {
    check('elapsed-observation', 'The complete configured real observation elapsed', record.measurement.actualWallMs >= observationMs && elapsedMonotonicMs >= observationMs, { requiredMs: observationMs, wallMs: record.measurement.actualWallMs, monotonicMs: elapsedMonotonicMs });
    check('independent-deadlines', 'Access and refresh remain valid beyond the observation', baseline.access.exp * 1000 > beforeReturn.now && record.measurement.baselineRefresh?.exp * 1000 > beforeReturn.now, { accessExpiry: baseline.access.exp, refreshExpiry: record.measurement.baselineRefresh.exp, observedAt: beforeReturn.now });
    check('no-early-timeout', 'No Timeout appears before the independent credential deadlines', opened.length === 0 && !beforeReturn.timeoutVisible, { opened, timeoutVisible: beforeReturn.timeoutVisible });
  } else {
    check('remote-no-stubs', 'Remote mode changes no network responses or application storage', record.networkRouteRegistrations === 0 && !record.fixtureSha256 && record.fixtureHits.length === 0, { registrations: record.networkRouteRegistrations, fixtureHits: record.fixtureHits });
    record.remoteOutcome = { timeoutEvents: opened, timeoutVisible: beforeReturn.timeoutVisible, signInVisible: beforeReturn.signInVisible, access: beforeReturn.access, refresh: latestRefresh, expiryMovingExtensions: extensions };
    record.limits.push('Remote mode records independent deadline outcomes. It does not impose a30-minute timeout policy.');
  }
  await event('MEASUREMENT_COMPLETE', { assertions: record.assertions, measurement: record.measurement });
  if (hidden) { await page.bringToFront(); await page.waitForFunction(() => document.visibilityState === 'visible', null, { timeout: 5000 }); }
  const returned = await checkpoint('returned-final');
  check('returned-component', 'Actual Blotter and grid remain mounted after the native return', returned.blotterMounted && returned.gridMounted, { blotterMounted: returned.blotterMounted, gridMounted: returned.gridMounted });
  if (args.case === 'RW-SHORT-IDLE') check('returned-timeout', 'Timeout remains visible immediately after native return', returned.timeoutVisible && returned.now - beforeReturn.now <= 5000, { timeoutVisible: returned.timeoutVisible, returnObservationMs: returned.now - beforeReturn.now });
  record.status = record.assertions.every(x => x.passed) ? 'PASSED' : 'FAILED';
  }
} catch (error) {
  record.status = stopped ? 'INTERRUPTED' : 'FAILED'; record.error = redact(error);
  if (page) await checkpoint('failed').catch(e => { record.captureError = redact(e); });
} finally {
  await Promise.allSettled(responseTasks);
  record.completedAt = new Date().toISOString();
  await writeExclusive('case-result-before-cleanup.json', record);
  if (owned?.browser) await owned.browser.close().catch(() => {});
  if (owned?.child.exitCode === null && owned?.child.signalCode === null) owned.child.kill('SIGTERM');
  if (owned) {
    await Promise.race([owned.exited, sleep(2000)]);
    if (owned.child.exitCode === null && owned.child.signalCode === null) { owned.child.kill('SIGKILL'); await Promise.race([owned.exited, sleep(2000)]); }
    await fs.rm(owned.profilePath, { recursive: true, force: true }); record.nativeBrowser.status = 'CLOSED';
  }
  if (lockHeld) await fs.unlink(lockPath);
  record.cleanupCompletedAt = new Date().toISOString();
  await writeExclusive('result.json', record);
  const manifest = [];
  for (const name of (await fs.readdir(output)).sort()) { const bytes = await fs.readFile(path.join(output, name)); manifest.push({ path: name, bytes: bytes.length, sha256: hash(bytes) }); }
  await writeExclusive('artifact-manifest.json', manifest);
}
console.log(JSON.stringify({ status: record.status, output, assertions: record.assertions.length, passed: record.assertions.filter(x => x.passed).length, error: record.error }));
process.exitCode = record.status === 'PASSED' ? 0 : 1;
