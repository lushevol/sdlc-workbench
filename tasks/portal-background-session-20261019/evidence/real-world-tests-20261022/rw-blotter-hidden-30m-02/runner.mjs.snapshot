process.on('SIGTERM', interrupt);
process.on('SIGINT', interrupt);
async function bindSources() {
  for (const suffix of ['runner.mjs', '../support/timing.cjs', '../support/common.cjs']) {
    const source = fileURLToPath(new URL(suffix, import.meta.url));
    const bytes = await fs.readFile(source);
    const name = 'driver-' + path.basename(source) + '.snapshot';
    await fs.writeFile(path.join(output, name), bytes, { flag: 'wx' });
    record.driverSources.push({ module: suffix, retained: name, sha256: hash(bytes) });
  }
