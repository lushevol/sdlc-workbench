async function installLocalFixtures(data) {
  record.limits.push(...data.limits);
  record.substitutions = ['Synthetic catalog, entitlements and empty business data; actual auth response headers and actual application component bytes.', 'Local notification SockJS /info returns503. Toolkit presentation elements use a disclosed substitute.'];
  await context.route('**/*', async route => {
    const request = route.request(), url = new URL(request.url());
    if (!['localhost', '127.0.0.1'].includes(url.hostname)) {
      record.fixtureHits.push({ time: Date.now(), route: safeUrl(url.href), fixture: 'NONLOCAL_BLOCKED' }); return route.abort('blockedbyclient');
    }
    if (!url.pathname.includes('/api/')) return route.continue();
    if (url.pathname.includes('/auth/')) {
      if (/\/sso\/(login|validate|extend|relogin)$/.test(url.pathname)) {
        const upstream = await route.fetch();
        if (!upstream.ok()) return route.fulfill({ response: upstream });
        const body = await upstream.json(); body.drawers = data.catalog.drawers; body.entities = data.catalog.entities;
        record.fixtureHits.push({ time: Date.now(), route: url.pathname, fixture: 'AUTH_BODY_ONLY', upstreamStatus: upstream.status() });
        return route.fulfill({ response: upstream, json: body });
      }
      return route.continue();
    }
    const exact = data.fixtures.responses.find(x => x.pathname === url.pathname && (!x.method || x.method === request.method()));
    record.fixtureHits.push({ time: Date.now(), route: url.pathname, fixture: exact ? 'DECLARED_BUSINESS_RESPONSE' : 'EMPTY_CANDIDATE_RESPONSE' });
    return route.fulfill({ status: exact?.status ?? 200, contentType: 'application/json', body: JSON.stringify(exact?.body ?? { data: [], result: true }) });
  });
