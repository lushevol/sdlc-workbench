    await page.screenshot({ path: path.join(output, name), timeout: 10000, mask: [page.locator(selectors.username), page.locator(selectors.password)] });
    item.screenshot = { path: name, sha256: hash(await fs.readFile(path.join(output, name))), method: 'Native Edge page.screenshot; username and password selectors masked.' };
  }
