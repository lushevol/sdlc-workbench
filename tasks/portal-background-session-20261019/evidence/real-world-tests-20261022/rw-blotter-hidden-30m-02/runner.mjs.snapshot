async function authenticate() {
  await page.goto(config.loginUrl || config.targetUrl);
  if (config.loginMode !== 'manual') {
    assert.ok(username && password, 'Private credential environment variables are required.');
    try { await page.locator(selectors.username).fill(username); await page.locator(selectors.password).fill(password); await page.locator(selectors.login).click(); }
    catch { throw new Error('Private sign-in did not complete.'); }
