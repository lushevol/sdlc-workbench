}
async function installObserver(fixtureData) {
  await context.addInitScript(({ selectors, localFixture, timerCaptureMinDelayMs, timerIdentification }) => {
    if (localFixture && ['localhost', '127.0.0.1'].includes(location.hostname) && !sessionStorage.getItem('__realWorldSeeded')) {
