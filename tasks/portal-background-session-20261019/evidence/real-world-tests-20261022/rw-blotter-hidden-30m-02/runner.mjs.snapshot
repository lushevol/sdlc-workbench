await fs.writeFile(path.join(output, 'config.json.snapshot'), retainedConfigBytes, { flag: 'wx' });
const record = {
  caseId: args.case, runId: args['run-id'], mode: config.mode, profile: config.profile,
  status: 'STARTING', startedAt: new Date().toISOString(), target: safeUrl(target.href),
  driverSha256: hash(runnerBytes), configurationSha256: hash(configBytes),
  retainedConfigurationSha256: hash(retainedConfigBytes), configurationRedacted: !retainedConfigBytes.equals(configBytes),
  evidenceRedaction: 'All serialized JSON replaces private credential environment values and JWT strings. Credential-bearing source bytes remain hash-only.',
  sourceRevisions: config.sourceRevisions || {}, sourceBindings: [], driverSources: [], serviceDates: [],
