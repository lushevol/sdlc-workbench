config.profile = { name: timing.name, purpose: timing.purpose, expectedAccessSeconds: timing.expectedAccessLifetimeSeconds, expectedRefreshSeconds: timing.expectedRefreshLifetimeSeconds ?? null };
assert.ok(Number.isFinite(config.profile.expectedAccessSeconds) && config.profile.expectedAccessSeconds > 0, 'Declare the expected access lifetime.');
