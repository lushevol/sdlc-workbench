package com.scb.sso.singleuibff.util;

import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.scb.sso.singleuibff.config.EMS2ConfigProperties;
import com.scb.sso.singleuibff.dto.config.EntitlementSource;
import com.scb.sso.singleuibff.dto.ems2.v2.Entity;
import com.scb.sso.singleuibff.dto.ems2.v2.Subject;
import com.scb.sso.singleuibff.dto.request.RequestOfApplicationTile;
import com.scb.sso.singleuibff.entity.ApplicationCategory;
import com.scb.sso.singleuibff.entity.ApplicationTile;
import com.scb.sso.singleuibff.entity.ImportMap;
import com.scb.sso.singleuibff.exceptions.JwtException;
import com.scb.sso.singleuibff.service.v1.SessionService;
import com.scb.sso.singleuibff.service.v2.authorization.TileAuthorizationResult;
import com.scb.sso.singleuibff.service.v2.filter.ems3.dto.Drawer;
import jakarta.servlet.http.HttpServletRequest;
import lombok.AllArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.apache.commons.lang3.StringUtils;
import org.springframework.beans.factory.annotation.Autowired;

import java.util.*;
import java.util.stream.Collectors;

import static com.scb.sso.singleuibff.service.v2.filter.ems3.util.Constant.EMS3;
import static com.scb.sso.singleuibff.util.Constant.*;

@Slf4j
@AllArgsConstructor
public class AdminModuleUtil {

    @Autowired
    private JwtTokenUtil jwtTokenUtil;
    @Autowired
    private ObjectMapper objectMapper;
    @Autowired
    private SessionService sessionService;
    @Autowired
    private EMS2ConfigProperties ems2ConfigProperties;

    public Map<String, String> validate(HttpServletRequest httpServletRequest, String entitlementsToken) {
        try {
            String jwtToken = jwtTokenUtil.retrieveHeaderToken(httpServletRequest.getHeader(HEADER_JWT_TOKEN));
            jwtTokenUtil.validateToken(jwtToken);
            jwtTokenUtil.handleIssuer(jwtToken, JWT_ISSUER);
            jwtTokenUtil.validateToken(entitlementsToken);
            jwtTokenUtil.handleIssuer(entitlementsToken, JWT_ISSUER_ENTITLEMENT);
            String content = jwtTokenUtil.retrieveUserInfoFromToken(entitlementsToken);
            Map<String, String> entitlementsPayload = objectMapper.readValue(content, HashMap.class);
            Map<String, String> entitlements = objectMapper.readValue(entitlementsPayload.get("entitlements"), HashMap.class);
            String ems2Role = entitlements.keySet().stream()
                .filter(i -> i.startsWith(ems2ConfigProperties.getAdminModuleEntity()))
                .map(i -> {
                    String[] s = i.split(":");
                    return s[1];
                }).toList().get(0);
            String userInfo = jwtTokenUtil.retrieveUserInfoFromToken(jwtToken);
            Map<String, String> payload = objectMapper.readValue(userInfo, HashMap.class);
            payload.put("ems2Role", ems2Role);
            sessionService.validateSession(payload.get(SESSION_ID));
            return payload;
        } catch (Exception e) {
            throw JwtException.builder().message("TOKEN_INVALID_EXPIRED - token validation failed.").build();
        }
    }

    public Map<String, String> validate(HttpServletRequest httpServletRequest) {
        try {
            String jwtToken = jwtTokenUtil.retrieveHeaderToken(httpServletRequest.getHeader(HEADER_JWT_TOKEN));
            jwtTokenUtil.validateToken(jwtToken);
            jwtTokenUtil.handleIssuer(jwtToken, JWT_ISSUER);
            String userInfo = jwtTokenUtil.retrieveUserInfoFromToken(jwtToken);
            Map<String, String> payload = objectMapper.readValue(userInfo, HashMap.class);
            sessionService.validateSession(payload.get(SESSION_ID));
            return payload;
        } catch (Exception e) {
            throw JwtException.builder().message("TOKEN_INVALID_EXPIRED - token validation failed.").build();
        }
    }

    private List<String> cleanEntity(Map<String, Object> item) {
        Object configuredEntities = item.get("ems2_entities");
        if (configuredEntities == null || StringUtils.isBlank(String.valueOf(configuredEntities))) {
            return List.of();
        }
        return Arrays.stream(String.valueOf(configuredEntities).split(","))
            .map(String::trim).filter(StringUtils::isNotBlank).distinct().toList();
    }

    public List<String> getEntityFromApplicationCategory(List<Map<String, Object>> applicationCategories) {
        List<String> resultEntity = new ArrayList<>();
        for (Map<String, Object> item : applicationCategories) {
            resultEntity.addAll(cleanEntity(item));
        }
        return resultEntity.stream().distinct().collect(Collectors.toList());
    }

    public List<Map<String, Object>> filterDrawers(List<Map<String, Object>> drawers, List<Entity> entities) {
        return filterDrawers(drawers, entities, Set.of(), Set.of(), Set.of());
    }

    private List<Map<String, Object>> filterDrawers(
        List<Map<String, Object>> drawers,
        List<Entity> entities,
        Set<Long> controlledTileIds,
        Set<Long> grantedTileIds,
        Set<Long> featureBypassedTileIds) {

        List<Map<String, Object>> result = new ArrayList<>();

        for (Map<String, Object> drawer : drawers) {
            List<Map<String, Object>> tiles = (List<Map<String, Object>>) drawer.get("tiles");
            List<Map<String, Object>> visible = new ArrayList<>();

            for (Map<String, Object> tile : tiles) {
                long tileId = controlledTileIds.isEmpty()
                    ? 0L
                    : Long.parseLong(String.valueOf(tile.get("id")));

                boolean template = Boolean.TRUE.equals(tile.get("isTemplate"));
                String[] configuredEntities = (String[]) tile.get("entity");

                if (controlledTileIds.contains(tileId)) {
                    if (featureBypassedTileIds.contains(tileId)) {
                        visible.add(tile);
                        continue;
                    }

                    if (!grantedTileIds.contains(tileId)) {
                        continue;
                    }

                    boolean entityMatched = template || entities.stream()
                        .filter(Objects::nonNull)
                        .filter(entity -> Arrays.asList(configuredEntities).contains(entity.getName()))
                        .filter(entity -> entity.getSubjects() != null)
                        .flatMap(entity -> entity.getSubjects().stream())
                        .filter(Objects::nonNull)
                        .anyMatch(subject -> subject.getEntitlementSource() == EntitlementSource.EMS3);

                    if (entityMatched) {
                        visible.add(tile);
                    }
                    continue;
                }

                if (template || legacyTileVisible(
                    configuredEntities,
                    (String) tile.get("subject"),
                    entities)) {
                    visible.add(tile);
                }
            }

            if (!visible.isEmpty()) {
                drawer.put("tiles", visible);
                result.add(drawer);
            }
        }

        return result;
    }

    private boolean legacyTileVisible(String[] configuredEntities, String subject, List<Entity> entities) {
        return entities.stream()
            .filter(Objects::nonNull)
            .filter(entity -> Arrays.asList(configuredEntities).contains(entity.getName()))
            .filter(entity -> entity.getSubjects() != null)
            .flatMap(entity -> entity.getSubjects().stream())
            .filter(Objects::nonNull)
            .filter(item -> item.getEntitlementSource() == EntitlementSource.EMS2)
            .anyMatch(item -> StringUtils.isBlank(subject)
                || subject.equalsIgnoreCase(item.getName()) || subject.equalsIgnoreCase(item.getLongName()));
    }

    public List<Map<String, Object>> getAuthorizedDrawer(
        List<Map<String, Object>> applicationCategories, TileAuthorizationResult authorization) {

        Set<Long> featureBypassedTileIds = authorization.featureControlledTileIds().isEmpty()
            ? Set.of()
            : applicationCategories.stream()
                .filter(row -> TileEntitlementConfig.sourceOf(
                    Objects.toString(row.get("entitlement_source"), null)) == EntitlementSource.EMS3)
                .filter(row -> !TileEntitlementConfig.requiresFeatureAuthorization(
                    Objects.toString(row.get("entitlement_app_feature"), null)))
                .map(row -> Long.parseLong(String.valueOf(row.get("application_tile_id"))))
                .filter(authorization.featureControlledTileIds()::contains)
                .collect(Collectors.toSet());

        return filterDrawers(
            buildDrawers(
                applicationCategories,
                authorization.featureControlledTileIds(),
                authorization.featureGrantedTileIds()),
            authorization.entitlements().getEntities(),
            authorization.featureControlledTileIds(),
            authorization.featureGrantedTileIds(),
            featureBypassedTileIds);
    }

    private List<Map<String, Object>> buildDrawers(
        List<Map<String, Object>> applicationCategories,
        Set<Long> controlledTileIds,
        Set<Long> grantedTileIds) {
        List<Map<String, Object>> drawers = new ArrayList<>();
        for (Map<String, Object> item : applicationCategories) {
            Map<String, Object> tile = new HashMap<>();
            tile.put("id", item.get("application_tile_id"));
            tile.put("container", "@fm/".concat((String) item.get("key_name")));
            tile.put("entity",
                drawerEntityNames(item, controlledTileIds, grantedTileIds).toArray(String[]::new));
            tile.put("subject", item.get("ems2_subject"));
            tile.put("isTemplate", item.get("is_template"));
            tile.put("module", "/".concat((String) item.get("module")));
            tile.put("tile", "/".concat((String) item.get("tile")));
            tile.put("title", item.get("title"));
            tile.put("subtitle", item.get("subtitle"));
            tile.put("imageDarkTheme", item.get("image_dark_theme"));
            tile.put("imageLightTheme", item.get("image_light_theme"));
            tile.put("emailSupport", item.get("email_support"));
            tile.put("filterRule", item.get("filter_rule"));
            tile.put("entryName", item.get("entry_name"));
            tile.put("entitlementSource", controlledTileIds.contains(
                Long.parseLong(String.valueOf(item.get("application_tile_id")))) ? "EMS3" : "EMS2");
            Map<String, Object> resultCheck = drawers.stream()
                .filter(t -> t.get("id").equals(item.get("application_category_id")))
                .findFirst().orElse(null);
            if (Objects.isNull(resultCheck)) {
                List<Map<String, Object>> tiles = new ArrayList<>();
                tiles.add(tile);
                Map<String, Object> record = new HashMap<>();
                record.put("id", item.get("application_category_id"));
                record.put("label", item.get("label"));
                record.put("tiles", tiles);
                drawers.add(record);
            } else {
                List<Map<String, Object>> tiles = (List<Map<String, Object>>) resultCheck.get("tiles");
                tiles.add(tile);
            }
        }
        return drawers;
    }

    public String checkIfNull(String input, String defaultValue) {
        return Objects.isNull(input) ? defaultValue : input.trim();
    }

    public boolean checkEms2Role(String ems2Role, ImportMap importMap, ApplicationCategory applicationCategory,
        ApplicationTile applicationTile) {
        return (!applicationTile.getEms2Role().equalsIgnoreCase(ems2Role)
            || !applicationCategory.getEms2Role().equalsIgnoreCase(ems2Role)
            || !importMap.getEms2Role().equalsIgnoreCase(ems2Role));
    }

    public boolean validateChecker(ApplicationTile applicationTile, RequestOfApplicationTile requestOfApplicationTile) {
        return (!applicationTile.isActive() && requestOfApplicationTile.getMode().equalsIgnoreCase("checker"));
    }

    public boolean checkSpaces(String module, String tile) {
        return (module.contains(" ") || tile.contains(" "));
    }

    public boolean checkBlank(String title, String module, String tile) {
        return (StringUtils.isBlank(title) || StringUtils.isBlank(module) || StringUtils.isBlank(tile));
    }

    public String verifyGetFilterRule(String filterRule) {
        if (StringUtils.isBlank(filterRule)) {
            filterRule = null;
        } else {
            try {
                JsonNode jsonNode = objectMapper.readTree(filterRule);
                if (!jsonNode.isObject()) {
                    throw new RuntimeException("filterRule must be a valid JSON object or null");
                } else {
                    Drawer.Tile.FilterRule rule = objectMapper.treeToValue(jsonNode, Drawer.Tile.FilterRule.class);
                    String filterType = rule.getFilterType();
                    if (StringUtils.isBlank(filterType) || !filterType.equalsIgnoreCase(EMS3)) {
                        throw new RuntimeException("filterRule.filterType cannot be null and must be 'EMS3'");
                    }
                }
            } catch (JsonProcessingException e) {
                throw new RuntimeException("Please provide json format value for filterRule, e:{}", e);
            }
        }
        return filterRule;
    }

    private List<String> drawerEntityNames(
        Map<String, Object> item,
        Set<Long> controlledTileIds,
        Set<Long> grantedTileIds) {
        if (controlledTileIds.isEmpty()) {
            return cleanEntity(item);
        }

        long tileId = Long.parseLong(String.valueOf(item.get("application_tile_id")));
        if (!controlledTileIds.contains(tileId)) {
            return cleanEntity(item);
        }

        if (!grantedTileIds.contains(tileId)) {
            return List.of();
        }

        return TileEntitlementConfig.split(
            Objects.toString(item.get("entitlement_app_name"), ""), false);
    }

}
