  "claim_register": [
    {
      "id": "KT-settlement-trade-lien-controls:1",
      "section": "Trade-level LIEN governs cashflows",
      "claim_scope": "LIEN placement or amount update makes every underlying payment type NSTP, including interest and notional.\nThe exception requires maker/checker handling.\nRemoval permits STP only when no other exception remains.\nLatest parent-trade LIEN is correlated through original trade identity.\nA resultant inherits LIEN when any component parent trade carries LIEN.\nOperations profiles cannot remove or edit the predefined exception.",
