--- /dev/null
+++ b/src/ratanutils/roleOwnership.ts
@@ -0,0 +1,37 @@
+import { getUser } from "./authenticator";
+
+interface SavedItemOwnership {
+  moduleOwner?: string | null;
+  assigneeList?: string | string[] | null;
+}
+
+// Snapshot the decision: true is role-owned, false is private, undefined is unknown.
+const ownership = new Map<string, Map<string, boolean | undefined>>();
+const key = (type: string) => JSON.stringify([getUser().id, type]);
+
+export const rememberRoleOwnership = (type: string, rowKey, record) => {
+  const current = ownership.get(key(type)) ?? new Map();
+  const known =
+    record &&
+    (Object.prototype.hasOwnProperty.call(record, "moduleOwner") ||
+      Object.prototype.hasOwnProperty.call(record, "assigneeList"));
+  current.set(String(rowKey), known ? isRoleOwnedItem(record) : undefined);
+  ownership.set(key(type), current);
+};
+
+export const replaceRoleOwnership = (type: string, records: any[]) => {
+  ownership.set(key(type), new Map());
+  records.forEach((record) =>
+    rememberRoleOwnership(type, record.rowKey, record)
+  );
+};
+
+export const readRoleOwnership = (type: string, rowKey) =>
+  ownership.get(key(type))?.get(String(rowKey));
+
+export const isRoleOwnedItem = (record: SavedItemOwnership | undefined) =>
+  !!record &&
+  (!!record.moduleOwner ||
+    (Array.isArray(record.assigneeList)
+      ? record.assigneeList.length > 0
+      : !!record.assigneeList));
