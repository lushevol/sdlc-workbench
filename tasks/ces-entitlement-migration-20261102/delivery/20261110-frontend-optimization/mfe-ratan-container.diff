@@ -0,0 +1,38 @@
+import { getUserProfile } from "./utils";
+
+let mockStore: any;
+jest.mock("../import", () => ({
+  Hooks: { getHooks: () => ({ store: mockStore }) },
+}));
+jest.mock("./index", () => ({ MonitorUser: class {} }));
+jest.mock("../Storage/crypto", () => ({ encode: (value) => value }));
+
+beforeEach(() => {
+  mockStore = {
+    user: { entitlements: { "X_RATANONE:FMO_OPS": {} } },
+    entities: [
+      {
+        applicationId: "51358",
+        name: "RATAN_ENTITLEMENT_RULE",
+        roleList: ["OPS", "SUP"],
+        subjects: [{ entitlementSource: "EMS3" }],
+      },
+      {
+        applicationId: "99999",
+        name: "RATAN_ENTITLEMENT_RULE",
+        roleList: ["OTHER_APP_ROLE"],
+        subjects: [{ entitlementSource: "EMS3" }],
+      },
+    ],
+  };
+});
+
+test("the no-argument telemetry helper preserves the legacy scalar label", () => {
+  expect(getUserProfile()).toBe("FMO_OPS");
+});
+
+test("CES assignments do not fabricate a legacy scalar telemetry profile", () => {
+  delete mockStore.user.entitlements;
+  expect(getUserProfile()).toBe("");
+  expect(mockStore.entities[0].roleList).toEqual(["OPS", "SUP"]);
+});
