diff --git a/src/ratanutils/authenticator.ces.test.ts b/src/ratanutils/authenticator.ces.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..16739ba99a3a77017b879274fa6fe7c6a42c7e1a
--- /dev/null
+++ b/src/ratanutils/authenticator.ces.test.ts
@@ -0,0 +1,466 @@
+import * as authenticator from "./authenticator";
+import { logger } from "./logger";
+
+jest.mock("./logger", () => ({ logger: { info: jest.fn() } }));
+
+let mockStore: any;
+jest.mock("../Root/import", () => ({
+  Hooks: { getHooks: () => ({ store: mockStore }) },
+}));
+
+const feature = "RATAN_CASHFLOW_BLOTTER";
+const code = `${feature}:F_Export_Data`;
+const cesRoute = {
+  tileId: "101",
+  source: "EMS3",
+  features: [feature],
+  applicationId: "51358",
+  entityNames: ["RATAN_ENTITLEMENT_RULE"],
+};
+const grant = (overrides: any = {}) => ({
+  name: "RATAN_ENTITLEMENT_RULE",
+  applicationName: "RATAN",
+  applicationId: "51358",
+  roleName: null,
+  roleList: ["OPS", "SUP"],
+  subjects: [
+    {
+      name: feature,
+      entitlementSource: "EMS3",
+      actions: [{ name: "F_Export_Data" }],
+    },
+  ],
+  ...overrides,
+});
+
+beforeEach(() => {
+  jest.clearAllMocks();
+  mockStore = {
+    user: { id: "1481696", fullName: "Test User" },
+    entities: [grant()],
+    entitlementRouting: [cesRoute],
+  };
+});
+
+// Canonical cases: tasks/ces-entitlement-migration-20261102/06-test-cases.md
+describe("CES provider adapter with unchanged permission calls", () => {
+  test("grants the exact configured application/feature/action", () => {
+    expect(authenticator.hasPermission(code)).toBe(true);
+    expect(authenticator.hasPermission(`${feature}:F_Delete`)).toBe(false);
+  });
+
+  test.each([
+    { applicationId: "99999" },
+    { name: "OTHER_APPLICATION" },
+    {
+      subjects: [
+        {
+          name: feature,
+          entitlementSource: "EMS2",
+          actions: [{ name: "F_Export_Data" }],
+        },
+      ],
+    },
+    {
+      subjects: [
+        {
+          name: "OTHER_FEATURE",
+          entitlementSource: "EMS3",
+          actions: [{ name: "F_Export_Data" }],
+        },
+      ],
+    },
+    {
+      subjects: [
+        {
+          name: feature,
+          entitlementSource: "EMS3",
+          actions: [{ name: "F_Delete" }],
+        },
+      ],
+    },
+  ])(
+    "denies a grant outside one complete configured chain (%j)",
+    (overrides) => {
+      mockStore.entities = [grant(overrides)];
+      expect(authenticator.hasPermission(code)).toBe(false);
+    }
+  );
+
+  test("evaluates all entity rows without overwriting an earlier grant", () => {
+    mockStore.entities = [
+      grant(),
+      grant({ subjects: [] }),
+      grant({ applicationId: "99999" }),
+    ];
+    expect(authenticator.hasPermission(code)).toBe(true);
+  });
+
+  test("a CES denial still accepts a valid flat EMS2 grant", () => {
+    mockStore.entities = [];
+    mockStore.user.entitlement = { role: "FMO_OPS", actions: [code] };
+    expect(authenticator.hasPermission(code)).toBe(true);
+  });
+
+  test("a configured EMS2 route cannot consume CES subjects", () => {
+    mockStore.entitlementRouting = [{ ...cesRoute, source: "EMS2" }];
+    mockStore.entities = [grant({ name: "X_RATANONE" })];
+    expect(authenticator.hasPermission(code)).toBe(false);
+  });
+
+  test("an EMS2 projection retains legacy subjects in a mixed-source row", () => {
+    mockStore.entitlementRouting = [{ ...cesRoute, source: "EMS2" }];
+    mockStore.entities = [
+      {
+        name: "X_RATANONE",
+        roleName: "FMO_OPS",
+        subjects: [
+          {
+            name: feature,
+            entitlementSource: "EMS2",
+            actions: [{ name: "F_Delete" }],
+          },
+          {
+            name: feature,
+            entitlementSource: "EMS3",
+            actions: [{ name: "F_Export_Data" }],
+          },
+        ],
+      },
+    ];
+    expect(authenticator.hasPermission(`${feature}:F_Delete`)).toBe(true);
+    expect(authenticator.hasPermission(code)).toBe(false);
+    expect(authenticator.getUser().role).toBe("FMO_OPS");
+  });
+
+  test.each([
+    [false, false, false, "NONE"],
+    [true, false, true, "EMS2"],
+    [false, true, true, "EMS3"],
+    [true, true, true, "EMS2"],
+  ])("EMS2=%s CES=%s returns %s and logs %s", (ems2, ces, expected, source) => {
+    mockStore.entitlementRouting = [
+      cesRoute,
+      { ...cesRoute, tileId: "102", source: "EMS2" },
+    ];
+    mockStore.user.entitlement = { actions: ems2 ? [code] : [] };
+    mockStore.entities = ces ? [grant()] : [grant({ subjects: [] })];
+    expect(authenticator.hasPermission(code)).toBe(expected);
+    const message = (logger.info as jest.Mock).mock.calls[0][0];
+    expect(JSON.parse(message.slice("Entitlement permission ".length))).toEqual(
+      {
+        code,
+        source,
+        allowed: expected,
+        ...(source === "EMS3" ? { applicationId: "51358" } : {}),
+      }
+    );
+  });
+
+  test("checks each configured CES application without denying valid mixed routes", () => {
+    mockStore.entitlementRouting = [
+      { ...cesRoute, applicationId: "other", tileId: "103" },
+      { ...cesRoute, applicationId: undefined, tileId: "104" },
+      cesRoute,
+    ];
+    expect(authenticator.hasPermission(code)).toBe(true);
+  });
+
+  test("recomputes decisions while logging repeated render checks only once", () => {
+    expect(authenticator.hasPermission(code)).toBe(true);
+    expect(authenticator.hasPermission(code)).toBe(true);
+    expect(logger.info).toHaveBeenCalledTimes(1);
+    mockStore.entities[0].subjects = [];
+    expect(authenticator.hasPermission(code)).toBe(false);
+    expect(logger.info).toHaveBeenCalledTimes(2);
+    mockStore.entities = [grant()];
+    expect(authenticator.hasPermission(code)).toBe(true);
+    expect(logger.info).toHaveBeenCalledTimes(3);
+  });
+
+  test("logs again for a different user sharing the same grant snapshot", () => {
+    expect(authenticator.hasPermission(code)).toBe(true);
+    mockStore.user = { id: "other-user" };
+    expect(authenticator.hasPermission(code)).toBe(true);
+    expect(logger.info).toHaveBeenCalledTimes(2);
+  });
+
+  test("logging failure cannot change the permission result", () => {
+    (logger.info as jest.Mock).mockImplementationOnce(() => {
+      throw new Error("logger unavailable");
+    });
+    expect(authenticator.hasPermission(code)).toBe(true);
+    expect(authenticator.hasPermission(code)).toBe(true);
+    expect(logger.info).toHaveBeenCalledTimes(2);
+  });
+
+  test("an unknown route does not block a valid EMS2 grant", () => {
+    mockStore.entitlementRouting = [];
+    mockStore.user.entitlement = { actions: [code] };
+    expect(authenticator.hasPermission(code)).toBe(true);
+  });
+
+  test.each([
+    { source: "UNKNOWN" },
+    { applicationId: undefined },
+    { entityNames: [] },
+    { features: [] },
+  ])(
+    "invalid or incomplete configured CES routing does not grant (%j)",
+    (overrides) => {
+      mockStore.entitlementRouting = [{ ...cesRoute, ...overrides }];
+      expect(authenticator.hasPermission(code)).toBe(false);
+      mockStore.user.entitlement = { actions: [code] };
+      expect(authenticator.hasPermission(code)).toBe(true);
+    }
+  );
+
+  test.each(["", `${feature}:`, `:${"F_Export_Data"}`, `${code}:extra`])(
+    "denies malformed CES permission %s",
+    (permission) => {
+      expect(authenticator.hasPermission(permission)).toBe(false);
+    }
+  );
+
+  test("changing the tile provider does not discard existing EMS2 grants", () => {
+    mockStore.entities.push({
+      name: "X_RATANONE",
+      roleName: "FMO_OPS",
+      subjects: [{ name: feature, actions: [{ name: "F_Delete" }] }],
+    });
+    expect(authenticator.hasPermission(code)).toBe(true);
+    expect(authenticator.hasPermission(`${feature}:F_Delete`)).toBe(true);
+    mockStore.entitlementRouting = [{ ...cesRoute, source: "EMS2" }];
+    expect(authenticator.hasPermission(code)).toBe(false);
+    expect(authenticator.hasPermission(`${feature}:F_Delete`)).toBe(true);
+  });
+
+  test("higher-level public-view helpers use the same CES resolver", () => {
+    mockStore.entities = [
+      grant({
+        subjects: [
+          {
+            name: feature,
+            entitlementSource: "EMS3",
+            actions: [{ name: "F_Custom_View_Builder_Public" }],
+          },
+        ],
+      }),
+    ];
+    expect(authenticator.hasPublicPermission("CASHFLOW_VIEW_BUILDER")).toBe(
+      true
+    );
+    expect(authenticator.hasPrivatePermission("CASHFLOW_VIEW_BUILDER")).toBe(
+      false
+    );
+  });
+
+  test("mixed-provider client-data close/replay retain the CES role-policy hold", () => {
+    mockStore.entitlementRouting = [
+      { ...cesRoute, features: ["RATAN_SETTLEMENT_EXCEPTION"] },
+      { ...cesRoute, source: "EMS2", features: ["RATAN_SETTLEMENT_EXCEPTION"] },
+    ];
+    mockStore.user.entitlement = {
+      role: "FMO_OPS",
+      actions: [
+        "RATAN_SETTLEMENT_EXCEPTION:F_Manually_Close_Exception",
+        "RATAN_SETTLEMENT_EXCEPTION:F_Replay_Exception",
+      ],
+    };
+    expect(
+      authenticator.hasCloseExceptionPermission("SETTLEMENTS_CLIENT_DATA")
+    ).toBe(false);
+    expect(
+      authenticator.hasReplayExceptionPermission("SETTLEMENTS_CLIENT_DATA")
+    ).toBe(false);
+  });
+
+  test.each([undefined, []])(
+    "unknown CES routing (%s) retains scalar-role exclusions",
+    (routes) => {
