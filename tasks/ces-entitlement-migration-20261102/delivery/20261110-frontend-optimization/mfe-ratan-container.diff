+  CommonUtil: {
+    getEnv: () => mockEnvironment,
+    getSessionStorage: () => ({
+      getItem: () => JSON.stringify({ id: "1481696" }),
+    }),
+  },
+}));
+
+beforeEach(() => {
+  mockPost.mockClear();
+  mockEnvironment = "PROD";
+  (globalThis as any).ratanConfig = {
+    disabledFeature: [],
+    REACT_APP_SERVER_ENV: "prod",
+  };
+  mockStore = {
+    user: { id: "1481696" },
+    entities: [
+      {
+        name: "RATAN_ENTITLEMENT_RULE",
+        applicationId: "51358",
+        roleList: ["OPS", "SUP"],
+        subjects: [
+          {
+            name: "RATAN_MO_RULE",
+            entitlementSource: "EMS3",
+            actions: [{ name: "View" }],
+          },
+        ],
+      },
+    ],
+    entitlementRouting: [
+      {
+        source: "EMS3",
+        applicationId: "51358",
+        entityNames: ["RATAN_ENTITLEMENT_RULE"],
+        features: ["RATAN_MO_RULE"],
+      },
+    ],
+  };
+});
+
+test("real logger initializes and sends one source record per repeated decision", () => {
+  expect(hasPermission("RATAN_MO_RULE:View")).toBe(true);
+  expect(hasPermission("RATAN_MO_RULE:View")).toBe(true);
+  expect(mockPost).toHaveBeenCalledTimes(1);
+  const [url, body] = mockPost.mock.calls[0];
+  expect(url).toBe("/api/ratan/v1/esLogging/prod/info");
+  expect(body.userId).toBe("1481696");
+  expect(
+    JSON.parse(body.message.slice("Entitlement permission ".length))
+  ).toEqual({
+    code: "RATAN_MO_RULE:View",
+    source: "EMS3",
+    applicationId: "51358",
+    allowed: true,
+  });
+  expect(body.message).not.toContain("roleList");
+});
+
+test("existing UAT logging policy remains independent from permission decisions", () => {
+  mockEnvironment = "UAT";
+  expect(hasPermission("RATAN_MO_RULE:View")).toBe(true);
+  expect(mockPost).not.toHaveBeenCalled();
+});
