+    ),
+    Checkbox: ({ children, ...props }) => <input type="checkbox" {...props} />,
+  }),
+  { virtual: true }
+);
+jest.mock("../LazyAntd/Select", () => ({
+  __esModule: true,
+  default: ({ disabled, "data-testid": id }) => (
+    <select disabled={disabled} data-testid={id} />
