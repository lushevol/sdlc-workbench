+++ b/src/hooks/dispathcer/ces.test.ts
@@ -0,0 +1,100 @@
+import useDispatcher from "./index";
+import { ActionType } from "../reducer/util/ActionType";
+
+const mockDispatch = jest.fn();
+let mockStore: any;
+jest.mock("../provider", () => ({
+  useContext: () => [mockStore, mockDispatch],
+}));
+jest.mock("../HooksBase", () => ({
+  getHooksBase: () => ({ store: {}, baseDispatch: jest.fn() }),
+}));
+
+const tile = {
+  id: 101,
+  title: "Cashflow",
+  container: "@fm/ratan",
+  module: "/blotter",
+  tile: "/cashflow",
+  entitlementSource: "EMS3",
+  subject: "CASHFLOW",
+  entity: ["RATAN_ENTITLEMENT_RULE"],
+};
+
+describe("shared tile launch compatibility", () => {
+  beforeEach(() => {
+    mockDispatch.mockClear();
+    mockStore = {
+      entities: [],
+      drawers: [{ tiles: [tile] }],
+      workspaces: [],
+      entitlementRouting: [
+        {
+          tileId: "101",
+          source: "EMS3",
+          entityNames: ["RATAN_ENTITLEMENT_RULE"],
+          applicationId: "51358",
+          features: ["CASHFLOW"],
+        },
+      ],
+    };
+  });
+
+  it("TC-FE-CES-012 preserves database identity and ordinary launch arguments", () => {
+    useDispatcher().dispatchOpenTile({ cashflowId: "C1" }, "cashflow");
+    const action = mockDispatch.mock.calls[0][0];
+    expect(action.type).toBe(ActionType.ADD_WORKSPACE);
+    const container = action.data.workspace.containers[0];
+    expect(container.applicationTileId).toBe("101");
+    expect(container.id).not.toBe("101");
+    expect(container.parameters).toEqual({ cashflowId: "C1" });
+  });
+
+  it("TC-FE-CES-012 rejects a revoked tile without creating a workspace", () => {
+    mockStore.drawers = [];
+    useDispatcher().dispatchOpenTile({}, "cashflow");
+    expect(mockDispatch).toHaveBeenCalledTimes(1);
+    expect(mockDispatch.mock.calls[0][0].type).toBe(ActionType.SET_ERRORMSG);
+  });
+
+  it("TC-FE-CES-003 preserves legacy server-admitted dispatcher behavior", () => {
+    mockStore.drawers = [
+      { tiles: [{ ...tile, entitlementSource: "EMS2", subject: "" }] },
+    ];
+    useDispatcher().dispatchOpenTile({}, "cashflow");
+    expect(mockDispatch.mock.calls[0][0].type).toBe(ActionType.ADD_WORKSPACE);
+  });
+
+  it("TC-FE-CES-012 rejects an ambiguous tile name", () => {
+    mockStore.drawers[0].tiles.push({ ...tile, id: 102 });
+    useDispatcher().dispatchOpenTile({}, "cashflow");
+    expect(mockDispatch.mock.calls[0][0].type).toBe(ActionType.SET_ERRORMSG);
+  });
+
+  it("preserves first-match named launches for duplicate EMS2 tiles", () => {
+    const legacy = { ...tile, entitlementSource: "EMS2", subject: "" };
+    mockStore.drawers = [{ tiles: [legacy, { ...legacy, id: 102 }] }];
+    useDispatcher().dispatchOpenTile({ cashflowId: "C1" }, "cashflow");
+    const action = mockDispatch.mock.calls[0][0];
+    expect(action.type).toBe(ActionType.ADD_WORKSPACE);
+    expect(action.data.workspace.containers[0].applicationTileId).toBe("101");
+    expect(action.data.workspace.containers[0].parameters).toEqual({ cashflowId: "C1" });
+  });
+
+  it("does not choose an arbitrary tile for a mixed-provider name", () => {
+    mockStore.drawers[0].tiles.unshift({ ...tile, entitlementSource: "EMS2", id: 102 });
+    useDispatcher().dispatchOpenTile({}, "cashflow");
+    expect(mockDispatch.mock.calls[0][0].type).toBe(ActionType.SET_ERRORMSG);
+  });
+
+  it("keeps legacy accessibility checks and cashflow launches usable for duplicate routes", () => {
+    const legacy = { ...tile, tile: "/trade", entitlementSource: "EMS2" };
+    mockStore.drawers = [{ label: "Settlement", tiles: [legacy, { ...legacy, id: 102 }] }];
+    expect(useDispatcher().checkRatanTradeBlotterAccessible()).toBe(true);
+    useDispatcher().dispacthOpenCashflow("C1", "/trade");
+    const action = mockDispatch.mock.calls[0][0];
+    expect(action.type).toBe(ActionType.ADD_WORKSPACE);
+    expect(action.data.workspace.containers[0].applicationTileId).toBe("101");
+    expect(action.data.workspace.containers[0].parameters).toEqual({ cashflowId: "C1" });
+  });
+});
