diff --git a/src/utils/tileAdmission.ts b/src/utils/tileAdmission.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8b9831bd77ed9128635e867fe936c1def925c647
--- /dev/null
+++ b/src/utils/tileAdmission.ts
@@ -0,0 +1,16 @@
+// Call only with a tile from the current server-authorized catalog.
+export const isCatalogTileAdmitted = (tile, entitlementRouting?): boolean => {
+  if (!tile) return false;
+  if (tile.entitlementSource === "EMS3") {
+    const routes = (
+      Array.isArray(entitlementRouting) ? entitlementRouting : []
+    ).filter(
+      (route) =>
+        route?.tileId != null &&
+        tile.id != null &&
+        String(route.tileId) === String(tile.id)
+    );
+    return routes.length === 1 && routes[0].source === "EMS3";
+  }
+  return tile.entitlementSource == null || tile.entitlementSource === "EMS2";
+};
diff --git a/src/utils/tileEntitlements.test.ts b/src/utils/tileEntitlements.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..9ace5ef220b953159bf3c99d503236d2b6e35612
--- /dev/null
+++ b/src/utils/tileEntitlements.test.ts
@@ -0,0 +1,112 @@
+import { canOpenTile, validateWorkspace } from "./common";
+
+jest.mock("../hooks/HooksBase", () => ({
+  getHooksBase: () => ({ store: {}, baseDispatch: jest.fn() }),
+}));
+
+const tile: any = {
+  id: 101,
+  container: "@fm/ratan",
+  module: "/blotter",
+  tile: "/cashflow",
+  subject: "CASHFLOW",
+  entity: ["RATAN_ENTITLEMENT_RULE"],
+  entitlementSource: "EMS3",
+};
+const drawers = [{ tiles: [tile] }];
+const routing: any[] = [
+  {
+    tileId: "101",
+    source: "EMS3",
+    applicationId: "51358",
+    entityNames: ["RATAN_ENTITLEMENT_RULE"],
+    features: ["CASHFLOW"],
+  },
+];
+const entity = (source: string) => ({
+  name: "RATAN_ENTITLEMENT_RULE",
+  subjects: [{ name: "CASHFLOW", entitlementSource: source, actions: [] }],
+});
+
+describe("per-tile provider admission", () => {
+  it("TC-FE-CES-003 uses CES features when the legacy subject is blank", () => {
+    const current = { ...tile, subject: "" };
+    expect(
+      canOpenTile([], current, [{ tiles: [current] }], routing as any)
+    ).toBe(true);
+  });
+
+  it("TC-FE-CES-003 preserves BFF-authorized CES tiles with no feature requirement", () => {
+    expect(
+      canOpenTile([], tile, drawers, [{ ...routing[0], features: [] }] as any)
+    ).toBe(true);
+  });
+
+  it("TC-FE-CES-003 admits a current BFF-authorized CES tile", () => {
+    expect(canOpenTile([], tile, drawers, routing)).toBe(true);
+  });
+
+  it("TC-FE-CES-003 denies a CES tile absent from the current catalog", () => {
+    expect(canOpenTile([entity("EMS3")], tile, [], routing)).toBe(false);
+  });
+
+  it("TC-FE-CES-003 preserves BFF admission when both feature and legacy subject are blank", () => {
+    const blank = { ...tile, subject: "" };
+    expect(
+      canOpenTile(
+        [],
+        blank,
+        [{ tiles: [blank] }],
+        [{ ...routing[0], features: [""] }]
+      )
+    ).toBe(true);
+  });
+
+  it.each([
+    undefined,
+    [],
+    [{ ...routing[0], source: "EMS2" }],
+    [routing[0], routing[0]],
+    [{ ...routing[0], tileId: "999" }],
+  ])("TC-FE-CES-003 rejects missing, conflicting, or mismatched CES route metadata (%#)", (routes) => {
+    expect(canOpenTile([], tile, drawers, routes)).toBe(false);
+  });
+
+  it("TC-FE-CES-003 denies invalid provider metadata", () => {
+    const invalid = { ...tile, entitlementSource: "OTHER" };
+    expect(canOpenTile([entity("EMS2")], invalid, [{ tiles: [invalid] }])).toBe(
+      false
+    );
+  });
+
+  it("TC-FE-CES-006 excludes CES subjects from EMS2 admission", () => {
+    const legacy = { ...tile, entitlementSource: "EMS2" };
+    expect(canOpenTile([entity("EMS3")], legacy, [{ tiles: [legacy] }])).toBe(
+      false
+    );
+    expect(canOpenTile([entity("EMS2")], legacy, [{ tiles: [legacy] }])).toBe(
+      true
+    );
+  });
+
+  it("TC-FE-CES-003 preserves omitted-source legacy grants", () => {
+    const legacy = { ...tile, entitlementSource: undefined };
+    const grants = [
+      { name: tile.entity[0], subjects: [{ name: tile.subject, actions: [] }] },
+    ];
+    expect(canOpenTile(grants, legacy, [{ tiles: [legacy] }])).toBe(true);
+  });
+
+  it("TC-FE-CES-012 restores a current CES tile and removes it after catalog revocation", () => {
+    const workspace = {
+      id: "workspace",
+      containers: [{ ...tile, id: "instance", applicationTileId: "101" }],
+    };
+    expect(validateWorkspace([workspace], [], drawers, routing)).toEqual([
+      workspace,
+    ]);
+    expect(
+      validateWorkspace([workspace], [], [], routing)[0].containers
+    ).toEqual([]);
+  });
+});
