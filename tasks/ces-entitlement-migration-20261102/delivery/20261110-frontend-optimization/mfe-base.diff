@@ -0,0 +1,67 @@
+import { findTile } from "./drawer";
+
+const route = {
+  container: "@fm/ratan",
+  module: "/blotter",
+  tile: "/cashflow",
+  entryName: "cashflow",
+};
+const tile = {
+  ...route,
+  id: 101,
+  entity: ["RATAN_ENTITLEMENT_RULE"],
+  subject: "CASHFLOW",
+  entitlementSource: "EMS3",
+};
+const workspace = (container) => ({ containers: [{ ...route, ...container }] });
+
+describe("CES workspace tile identity", () => {
+  it("TC-FE-CES-012 resolves the retained database tile ID", () => {
+    const second = { ...tile, id: 102 };
+    expect(
+      findTile(
+        [{ tiles: [tile, second] }],
+        workspace({ applicationTileId: "102" })
+      )
+    ).toBe(second);
+  });
+
+  it("TC-FE-CES-012 rejects a removed tile even when its old route remains", () => {
+    expect(
+      findTile([{ tiles: [tile] }], workspace({ applicationTileId: "999" }))
+    ).toBeUndefined();
+  });
+
+  it("TC-FE-CES-012 restores a legacy workspace using a unique route", () => {
+    expect(findTile([{ tiles: [tile] }], workspace({}))).toBe(tile);
+  });
+
+  it("TC-FE-CES-012 rejects ambiguous CES routes without retained identity", () => {
+    expect(
+      findTile([{ tiles: [tile, { ...tile, id: 102 }] }], workspace({}))
+    ).toBeUndefined();
+  });
+
+  it("preserves first-match restoration for duplicate EMS2 routes", () => {
+    const legacy = { ...tile, entitlementSource: "EMS2" };
+    expect(
+      findTile([{ tiles: [legacy, { ...legacy, id: 102 }] }], workspace({}))
+    ).toBe(legacy);
+  });
+
+  it("rejects ambiguous mixed-provider routes without retained identity", () => {
+    expect(
+      findTile(
+        [{ tiles: [{ ...tile, entitlementSource: "EMS2" }, { ...tile, id: 102 }] }],
+        workspace({})
+      )
+    ).toBeUndefined();
+  });
+
+  it("rejects duplicate database IDs even for EMS2 tiles", () => {
+    const legacy = { ...tile, entitlementSource: "EMS2" };
+    expect(
+      findTile([{ tiles: [legacy, { ...legacy }] }], workspace({ applicationTileId: "101" }))
+    ).toBeUndefined();
+  });
+});
