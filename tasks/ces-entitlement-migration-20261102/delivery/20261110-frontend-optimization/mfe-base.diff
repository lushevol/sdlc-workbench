+import { getName, getProfileActions } from "./util";
+
+describe("CES profile labels", () => {
+  it("TC-FE-CES-011 keeps the team label and formats all CES assignments", () => {
+    expect(
+      getName({
+        applicationName: "RATAN",
+        name: "RATAN_ENTITLEMENT_RULE",
+        roleName: null,
+        roleList: ["Role A", "Role B"],
+      })
+    ).toBe("RATAN :: RATAN_ENTITLEMENT_RULE :: Role A, Role B");
+  });
+
+  it("TC-FE-CES-011 preserves the existing EMS2 role label", () => {
+    expect(
+      getName({
+        applicationName: "RATAN",
+        name: "X_RATANONE",
+        roleName: "FMO_OPS",
+      })
+    ).toBe("RATAN :: X_RATANONE :: FMO_OPS");
+  });
+
+  it("TC-FE-CES-011 displays structured CES actions without a legacy token key", () => {
+    const subject = {
+      id: null,
+      name: "CASHFLOW",
+      entitlementSource: "EMS3",
+      actions: [{ name: "Export" }],
+    };
+    expect(
+      getProfileActions(
+        { name: "RATAN_ENTITLEMENT_RULE", roleName: null },
+        subject,
+        {}
+      )
+    ).toEqual(["Export"]);
+  });
+
+  it("TC-FE-CES-011 keeps existing EMS2 token action lookup", () => {
+    expect(
+      getProfileActions(
+        { name: "X_RATANONE", roleName: "OPS" },
+        { name: "CASHFLOW" },
+        { "X_RATANONE:OPS": { CASHFLOW: ["Export"] } }
+      )
+    ).toEqual(["Export"]);
+  });
+});
