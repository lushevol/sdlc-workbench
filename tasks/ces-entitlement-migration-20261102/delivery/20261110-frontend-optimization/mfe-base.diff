+          "RATAN :: RATAN_ENTITLEMENT_RULE :: Role A, Role B",
+          jest.fn()
+        )}
+      </>
+    );
+    fireEvent.click(screen.getByRole("button", { name: "CASHFLOW" }));
+    expect(screen.getByText("Export")).toBeInTheDocument();
+  });
+
+  it("TC-FE-CES-011 gives null-ID applications and subjects distinct accessible header IDs", () => {
+    const application = {
+      ...entity,
+      subjects: [
+        entity.subjects[0],
+        { ...entity.subjects[0], name: "NETTING" },
+      ],
+    };
+    render(
+      <>
+        {RoleComp(
+          [application, { ...application, applicationId: "999" }],
+          "RATAN :: RATAN_ENTITLEMENT_RULE :: Role A, Role B",
+          jest.fn()
+        )}
+      </>
+    );
+    const headers = Array.from(
+      document.querySelectorAll(
+        '[id^="entity-header-"], [id^="subject-header-"]'
+      )
+    );
+    expect(headers).toHaveLength(6);
+    expect(new Set(headers.map((item) => item.id)).size).toBe(6);
