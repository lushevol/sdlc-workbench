+  id: null,
+  name: "RATAN_ENTITLEMENT_RULE",
+  applicationId: "51358",
+  applicationName: "RATAN",
+  roleName: null,
+  roleList: ["Role A", "Role B"],
+  subjects: [
+    {
+      id: null,
+      name: "CASHFLOW",
+      entitlementSource: "EMS3",
+      actions: [{ id: null, name: "Export" }],
