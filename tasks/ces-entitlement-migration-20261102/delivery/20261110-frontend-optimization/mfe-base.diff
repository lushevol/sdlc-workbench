+import { act, renderHook } from "@testing-library/react";
+import useServices from "./useServices";
+
+const mockPostService = jest.fn();
+jest.mock("../../../hooks/service", () => ({
+  postService: (...args) => mockPostService(...args),
+}));
+jest.mock("../../../hooks/HooksBase", () => ({
+  getHooksBase: () => ({ baseDispatch: jest.fn() }),
+}));
+
+describe("tile migration configuration requests", () => {
+  beforeEach(() => {
+    mockPostService.mockClear();
+    mockPostService.mockResolvedValue({ data: { data: {} } });
+  });
+
+  it.each(["createTile", "updateTile", "verifyTile"])(
+    "TC-FE-CES-004 forwards the CES configuration through %s",
+    async (method) => {
+      const config = {
+        entitlementSource: "EMS3",
+        entitlementAppId: "51358",
+        entitlementAppName: "RATAN_ENTITLEMENT_RULE",
+        entitlementAppFeature: "CASHFLOW",
+      };
+      const { result } = renderHook(() => useServices());
+      await act(async () => { await result.current[method]("test-token", config); });
+      expect(mockPostService).toHaveBeenCalledTimes(1);
+      expect(mockPostService.mock.calls[0][1]).toEqual(expect.objectContaining(config));
+    }
+  );
+});
