+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { ViewName } from "../ratancomponents/ViewSelector/ViewName";
+import { FilterName } from "../ratancomponents/FilterSelector/FilterName";
+import { Context as ViewContext } from "../ratancomponents/ViewSelector/store";
+import { Context as FilterContext } from "../ratancomponents/FilterSelector/store";
+
+// TC-FE-CES-014: disabled role controls and unchanged private creator-owned writes.
+let mockRoleOwned = true;
+jest.mock("./authenticator", () => ({
+  getUser: () => ({ id: "1481696" }),
+  hasPrivatePermission: () => true,
+  hasPublicPermission: () => true,
+  isRoleOwnershipPending: () => true,
+}));
+jest.mock("./componentEnabling", () => ({ getEnable: () => true }));
+jest.mock("../ratancomponents/ViewSelector/store", () => ({
+  Context: require("react").createContext({}),
+}));
+jest.mock("../ratancomponents/FilterSelector/store", () => ({
+  Context: require("react").createContext({}),
+}));
+jest.mock(
+  "../ratancomponents/ViewSelector/common/useViewNameController",
+  () => ({
+    __esModule: true,
+    default: () => ({
+      newName: "Saved View",
+      newRole: mockRoleOwned ? "OPS" : "",
+      isModify: true,
+      isReadOnly: false,
+      thisViewHasPermission: () => true,
+      chooseAuthority: !mockRoleOwned,
+    }),
+  })
+);
+jest.mock(
+  "../ratancomponents/FilterSelector/common/useFieldNameController",
+  () => ({
+    __esModule: true,
+    default: () => ({ isModify: true, isReadOnly: false }),
+  })
+);
+jest.mock("../Root/import", () => ({
+  LoadingButton: ({ children, loading, variant, color, ...props }) => (
+    <button {...props}>{children}</button>
+  ),
+}));
+jest.mock(
+  "antd",
+  () => ({
+    message: { useMessage: () => [{}, null] },
+    Popconfirm: ({ children }) => <div>{children}</div>,
+    Select: ({ disabled, "data-testid": id }) => (
+      <select disabled={disabled} data-testid={id} />
+    ),
+    Checkbox: ({ children, ...props }) => <input type="checkbox" {...props} />,
+  }),
+  { virtual: true }
+);
+jest.mock("../LazyAntd/Select", () => ({
+  __esModule: true,
+  default: ({ disabled, "data-testid": id }) => (
+    <select disabled={disabled} data-testid={id} />
+  ),
+}));
+jest.mock("../LazyAntd/Input", () => ({
+  __esModule: true,
+  default: ({ allowClear, ...props }) => <input {...props} />,
+}));
+jest.mock("../LazyAntd/Checkbox", () => ({
+  __esModule: true,
+  default: ({ children, ...props }) => <input type="checkbox" {...props} />,
+}));
+jest.mock("../ratancomponents/ViewSelector/ViewNameStyles", () => ({
+  __esModule: true,
+  default: "div",
+}));
+jest.mock("../ratancomponents/FilterSelector/FilterNameStyles", () => ({
+  __esModule: true,
+  default: "div",
+}));
+
+const renderNames = () => {
+  const item = {
+    name: "Saved Filter",
+    assigneeList: mockRoleOwned ? "OPS" : "",
+    moduleOwner: mockRoleOwned ? "OPS" : "",
+  };
+  const view = renderToStaticMarkup(
+    <ViewContext.Provider value={{ state: { currentView: item } }}>
+      <ViewName viewFieldType="TRADE_VIEW_BUILDER" onSearch={() => {}} />
+    </ViewContext.Provider>
+  );
+  const filter = renderToStaticMarkup(
+    <FilterContext.Provider
+      value={{ state: { temporaryFilter: item, currentFilter: item } }}
+    >
+      <FilterName
+        filterFieldType="TRADE_FILTER_BUILDER"
+        onRemove={() => {}}
+        messageApi={{} as any}
+      />
+    </FilterContext.Provider>
+  );
+  return { view, filter };
+};
+
+const tags = (html) => html.match(/<(button|select)\b[^>]*>[^<]*/g) ?? [];
+
+test("CES role controls and role-owned save/remove buttons are disabled", () => {
+  mockRoleOwned = true;
+  const { view, filter } = renderNames();
+  for (const html of [view, filter]) {
+    const controls = tags(html);
+    expect(controls.length).toBe(3);
+    controls.forEach((tag) => expect(tag).toContain("disabled"));
+  }
+});
+
+test("CES private creator-owned save/remove buttons remain enabled", () => {
+  mockRoleOwned = false;
+  const { view, filter } = renderNames();
+  for (const html of [view, filter]) {
+    const buttons = tags(html).filter((tag) => tag.startsWith("<button"));
+    expect(buttons.length).toBe(2);
+    buttons.forEach((tag) => expect(tag).not.toContain("disabled"));
+  }
+});
