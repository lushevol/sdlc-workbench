+const resolveConfiguredTarget = (
+  code: string,
+  scope?: EntitlementScope
+): EntitlementRoute | undefined => {
+  const routes: EntitlementRoute[] | undefined =
+    getHooks().store?.entitlementRouting;
+  if (!Array.isArray(routes)) return undefined;
+  const feature = code.split(":")[0];
+  let candidates = routes.filter(
+    (route) =>
+      Array.isArray(route.features) &&
+      route.features.some(
+        (configured) =>
+          configured === feature ||
+          (route.source === "EMS2" &&
+            typeof configured === "string" &&
+            (configured.toLocaleUpperCase().replace(/\s/g, "_") === feature ||
+              (feature === "RATAN_SETTLEMENT_STP_RULE" &&
+                configured === "RATAN Settlement NSTP Rule")))
+      )
+  );
+  if (scope) {
+    const bound = routes.filter((route) => route.tileId === scope.tileId);
+    if (!bound.length) return undefined;
+    const boundCandidates = candidates.filter(
+      (route) => route.tileId === scope.tileId
+    );
+    // Cross-feature calls still resolve the requested feature's application.
+    if (boundCandidates.length) candidates = boundCandidates;
+  }
+  if (!candidates.length) return undefined;
+  const valid = candidates.every(
+    (route) =>
+      route.source === "EMS2" ||
+      (route.source === "EMS3" &&
+        typeof route.applicationId === "string" &&
+        !!route.applicationId.trim() &&
+        Array.isArray(route.entityNames) &&
+        !!route.entityNames.length &&
+        route.entityNames.every(
+          (name) => typeof name === "string" && !!name.trim()
+        ))
+  );
+  if (!valid) return undefined;
+  const identity = (route: EntitlementRoute) =>
+    route.source === "EMS2"
+      ? "EMS2"
+      : JSON.stringify([
+          route.source,
+          route.applicationId,
+          [...new Set(route.entityNames)].sort(),
+        ]);
+  const first = candidates[0];
+  return candidates.every((route) => identity(route) === identity(first))
+    ? first
+    : undefined;
+};
+
+const checkPermission = (code: string, scope?: EntitlementScope): boolean => {
+  const store = getHooks().store;
+  if (store?.entitlementRouting === undefined) {
+    const entities = [
+      ...(store?.entities ?? []),
+      ...(store?.user?.entities ?? []),
+    ];
+    // Preserve old deployments, without using legacy fallback for mixed/CES data.
+    return !scope && !entities.some(isCesEntity) && legacyHasPermission(code);
+  }
+  const target = resolveConfiguredTarget(code, scope);
+  if (!target) return false;
+  if (target.source === "EMS2") return legacyHasPermission(code);
+  const [feature, action, ...extra] = code.split(":");
+  if (!feature || !action || extra.length) return false;
+  return (store?.entities ?? []).some(
+    (entity) =>
+      entity.applicationId === target.applicationId &&
+      target.entityNames.includes(entity.name) &&
+      entity.subjects?.some(
+        (subject) =>
+          subject.entitlementSource === "EMS3" &&
+          subject.name === feature &&
+          subject.actions?.some((item) => item.name === action)
+      )
+  );
+};
+
+export const hasPermission = (code: string): boolean => checkPermission(code);
+
+export const createAuthenticator = (scope: EntitlementScope) => ({
