+export const isRoleOwnershipPending = (builderType: string): boolean => {
+  const features = builderFeatures[builderType] ?? [builderType];
+  const store = getHooks().store;
+  // Do not discard a configured CES alias merely because its target conflicts.
+  if (
+    Array.isArray(store?.entitlementRouting) &&
+    store.entitlementRouting.some(
+      (route) =>
+        route.source !== "EMS2" &&
+        Array.isArray(route.features) &&
+        route.features.some((feature) => features.includes(feature))
+    )
+  )
+    return true;
+  const targets = features
+    .map((feature) => resolveConfiguredTarget(`${feature}:_role_ownership_`))
