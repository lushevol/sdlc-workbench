{
  "date": "2026-11-03",
  "mode": "read-only local source inspection; no live calls",
  "authority": "tasks/draft-ces-migration/evidence/coverage-automation-20261103/user-input.md",
  "mapping": {
    "EMS2 role": "CES entitlement",
    "EMS2 entity": "CES app",
    "EMS2 subject": "CES feature",
    "EMS2 action": "CES action"
  },
  "fmo_disposition": "Latest user states non-production only, unlaunched, no current assignments. Exclude from production denominator; retain lower-priority optional comparison. Historical matrix assignments do not override this intent.",
  "api_contracts": [
    {
      "name": "EMS2 user permissions",
      "method": "POST",
      "endpoint": "/ems2/rest/entitlements/entitlementList",
      "request_json": "{account_id: [scoped EMS2 entity names]}",
      "response_json": "{account_id: {entitlements: [{subject:{name,entity:{name,id}},role:{name,entity:{name,id}},action:{name,entity:{name,id}}}], count:N}}",
      "assertions": [
        "Returned key must match requested string ID.",
        "count must equal number of returned records.",
        "Explicit empty entitlements with count zero differs from missing/malformed account result.",
        "All three nested entity references should remain consistent."
      ],
      "authentication": "Collection inherits auth; actual EMS2 auth configuration is not established by supplied files."
    },
    {
      "name": "EMS2 entity subjects",
      "method": "GET",
      "endpoint": "/ems2/rest/entity/{entity_id}/subjects",
      "response_json": "{subjects:[{id,name,longName,entity:{id,name,systemName,locked}}],count:N}",
      "assertions": [
        "Check count equals list length.",
        "No actions or role-specific grants are supplied.",
        "X_RATANONE file labelled subjects actually calls /roles; must not parse it as a subject response."
      ],
      "entity_ids_prod": {
        "X_RATANONE": "11491550",
        "RATAN_FUNC": "9794550",
        "RATAN_DATA_ENTITLEMENT": "11501650"
      }
    },
    {
      "name": "EMS2 entity roles",
      "method": "GET",
      "endpoint": "/ems2/rest/entity/{entity_id}/roles",
      "response_json": "{roles:[{id,name,entity:{id,name},roleDescription,isPrivilege}],count:N}",
      "assertions": [
        "Role inventory is separate from grant definitions and account assignments.",
        "Only X_RATANONE role endpoint has a retained sample; other entity role endpoints are not evidenced by these captures."
      ]
    },
    {
      "name": "CES application catalog",
      "method": "GET",
      "endpoint": "/fmces/v1/entitlement/app/{itam_id}/{app_name}",
      "response_json": "[{entitlement_id,entitlement_name,role_entitlements:[{feature,action}],user_ids:[string IDs]}]",
      "scope": {
        "itam_id": "51358",
        "app_name": "RATAN_ENTITLEMENT_RULE"
      },
      "authentication": "Authorization: Bearer token supplied privately. Existing captured token is not reproduced in these notes.",
      "assertions": [
        "Parse every user_ids array, not only the two supplied human examples.",
        "Compare role-specific grant content, not only the flattened union.",
        "Empty role grant lists are observable content; do not drop the profile definition."
      ]
    },
    {
      "name": "CES effective account permissions",
      "method": "GET",
      "endpoint": "/fmces/v1/entitlement/app/{itam_id}/{app_name}/user/{account_id}",
      "response_json": "[{user_data:{user_id,app_name,itam_id},entitlements:{entitlement_name:[],role_entitlements:[{feature,action}],data_policies:{...},data_profiles:{...},data_entitlements:[...]}}]",
      "assertions": [
        "Match returned user, app, and ITAM to requested scope.",
        "Effective pairs lack per-pair role provenance; use catalog for role definition assertions.",
        "Empty list, unavailable response, wrong ID, and genuinely empty permissions require distinct statuses.",
        "CES data policies/resolved values lack equivalent complete EMS2 field/value definitions in supplied sources."
      ]
    }
  ],
