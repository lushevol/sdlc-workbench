verification.mode=live
verification.users=config/users.local.csv
# Keep false until the declared population has an authoritative complete source.
verification.population-complete=false
verification.population-source=REPLACE_WITH_REVIEWED_ACCOUNT_INVENTORY_SOURCE
verification.ems2.base-url=${SDK_VERIFY_EMS2_BASE_URL}
verification.ces.base-url=${SDK_VERIFY_CES_BASE_URL}
verification.ces.mappings-file=config/company-mappings.local.json
verification.ems2.account-path=/ems2/rest/account/%s
verification.ems2.entitlements-path=/ems2/rest/entitlements/entitlementList
verification.ces.assigned-roles-path=/fmces/v1/entitlement/user/{userId}
