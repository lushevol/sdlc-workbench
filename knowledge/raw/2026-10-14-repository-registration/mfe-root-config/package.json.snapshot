{
  "name": "@fm/root-config-origin",
  "version": "PACKAGE_VERSION",
  "scripts": {
    "preinstall": "npx npm-force-resolutions",
    "local": "node --max-http-header-size=84000 ./node_modules/webpack/bin/webpack.js serve",
    "start": "env-cmd -f .env.local concurrently npm:copy npm:local",
    "lint": "eslint src --ext js,ts,tsx",
    "test": "cross-env BABEL_ENV=test jest --coverage --ci --passWithNoTests",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "prepare": "husky install",
    "build": "concurrently npm:copy npm:build:*",
    "build:webpack": "env-cmd -f .env.server webpack --mode=production",
    "build:types": "tsc",
    "pre-commit": "prettier --write ./src",
    "post-commit": "pretty-quick --staged",
    "pre-push": "concurrently npm:test npm:lint",
    "copy": "node ./scripts/copy",
    "ansible-deploy": "node ansible/ansible.js"
  },
  "resolutions": {},
  "devDependencies": {
    "@babel/core": "^7.15.0",
    "@babel/eslint-parser": "^7.15.0",
    "@babel/plugin-transform-runtime": "^7.15.0",
    "@babel/preset-env": "^7.15.0",
    "@babel/preset-typescript": "^7.15.0",
    "@babel/runtime": "^7.15.3",
    "concurrently": "^6.2.1",
    "cross-env": "^7.0.3",
    "env-cmd": "^10.1.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-config-ts-important-stuff": "^1.1.0",
    "eslint-plugin-prettier": "^3.4.1",
    "html-webpack-plugin": "^5.3.2",
    "husky": "^7.0.2",
    "jest": "^27.0.6",
    "jest-cli": "^27.0.6",
    "jest-junit": "^16.0.0",
    "jest-sonar": "^0.2.16",
    "prettier": "^2.3.2",
    "pretty-quick": "^3.1.1",
    "serve": "^12.0.0",
    "ts-config-single-spa": "^3.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^4.3.5",
    "webpack": "^5.51.1",
    "webpack-cli": "^4.8.0",
    "webpack-config-single-spa-ts": "^4.0.0",
    "webpack-dev-server": "^4.0.0",
    "webpack-merge": "^5.8.0"
  },
  "dependencies": {
    "@types/jest": "^27.0.1",
    "@types/systemjs": "^6.1.1",
    "@types/webpack-env": "^1.16.2",
    "single-spa": "^5.9.3",
    "single-spa-layout": "^1.6.0"
  },
  "types": "dist/fm-root-config.d.ts"
}
