FROM artifactory.global.standardchartered.com/marketsquare/robotframework-browser:18.8.1

LABEL description="Ratan auto test API Image - UI"

ENV TZ=Asia/Shanghai
ENV COMMAND="robot --dryrun"

ARG user=pwuser

USER root
COPY Install/cert/*.crt /usr/local/share/ca-certificates/
RUN update-ca-certificates

USER ${user}

WORKDIR /home/${user}

COPY --chown=${user}:${user} . /home/${user}/

COPY Install/pip.conf /home/${user}/.pip/pip.conf
COPY Install/.npmrc /home/${user}/.npmrc

RUN pip install --upgrade pip && pip install -r Install/requirements.txt

CMD $COMMAND

#CMD $ROBOT_COMMAND --variable SECRET:decrypt --variable HEADLESSENABLE:True --outputdir ./Report  Tests/ratan/workspace/ui/trade_blotter Tests/ratan/workspace/apiScript

#CMD $ROBOT_COMMAND  python ./GenResults.py $RUN_ID ./Report