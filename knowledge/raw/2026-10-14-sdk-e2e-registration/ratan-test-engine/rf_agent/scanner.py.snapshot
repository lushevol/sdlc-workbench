"""
RF Keyword Scanner
==================
Startup-time scanner that builds a full keyword index from:
  1. All .resource / .robot files under the project
  2. All Python keyword libraries (.py) under Resources/keywords
  3. Standard RF built-in libraries

Uses robot.api for resource/robot files and robot.libdocpkg for Python libs.
"""

import os
import re
import sys
import json
import logging
from dataclasses import dataclass, field, asdict
from pathlib import Path
from typing import Optional

logger = logging.getLogger(__name__)

# ─── Data Model ────────────────────────────────────────────────────────────────

@dataclass
class KeywordInfo:
    name: str
    source_file: str          # relative path from project root
    source_type: str          # "resource" | "python_lib" | "builtin"
    library_or_resource: str  # logical name, e.g. "keyword-api-cn" or "Collections"
    arguments: list[str] = field(default_factory=list)
    doc: str = ""
    tags: list[str] = field(default_factory=list)

    def to_dict(self):
        return asdict(self)

    def summary(self) -> str:
        args = "    ".join(self.arguments) if self.arguments else "(no args)"
        src = f"[{self.library_or_resource}]"
        doc_line = self.doc.strip().splitlines()[0] if self.doc.strip() else ""
        return f"{self.name}    {args}\n    # {src}  {doc_line}"


# ─── Scanner ───────────────────────────────────────────────────────────────────

class KeywordScanner:
    """Scans the whole project and returns a flat list of KeywordInfo."""

    # RF built-in libraries to always load
    BUILTIN_LIBS = [
        "BuiltIn",
        "Collections",
        "String",
        "OperatingSystem",
        "DateTime",
        "XML",
        "Process",
        "Screenshot",
        "Dialogs",
    ]

    # Extra installed libs commonly used in this project
    EXTRA_LIBS = [
        "RequestsLibrary",
        "Browser",
        "JSONLibrary",
        "FakerLibrary",
        "DatabaseLibrary",
        "SSHLibrary",
        "RedisLibrary",
        "CryptoLibrary",
    ]

    def __init__(self, project_root: str):
        self.project_root = Path(project_root).resolve()
        self.keywords: list[KeywordInfo] = []
        self._seen: set[str] = set()   # deduplicate by "name||source_file"

    # ── Public entry point ──────────────────────────────────────────────────

    def scan_all(self) -> list[KeywordInfo]:
        """Run full scan. Safe to call multiple times (re-runs scan)."""
        self.keywords = []
        self._seen = set()

        self._scan_resource_files()
        self._scan_python_libs()
        self._scan_builtin_libs()

        logger.info(f"[Scanner] Total keywords indexed: {len(self.keywords)}")
        return self.keywords

    # ── Resource / Robot file scanning ─────────────────────────────────────

    def _scan_resource_files(self):
        """Parse .resource and .robot files with robot.api to extract keywords."""
        try:
            from robot.api import get_model
        except ImportError:
            logger.warning("robot.api not available – skipping resource file scan")
            return

        patterns = ["**/*.resource", "**/*.robot"]
        files_found = []
        for pat in patterns:
            files_found.extend(self.project_root.glob(pat))

        for fpath in files_found:
            # skip cache / temp dirs
            if any(p in str(fpath) for p in ["__pycache__", ".git", "node_modules", "results", "output"]):
                continue
            self._parse_resource_file(fpath)

    def _parse_resource_file(self, fpath: Path):
        try:
            from robot.api import get_model
            model = get_model(str(fpath))
        except Exception as e:
            logger.debug(f"[Scanner] Cannot parse {fpath}: {e}")
            return

        rel_path = str(fpath.relative_to(self.project_root)).replace("\\", "/")
        lib_name = fpath.stem  # e.g. "keyword-api-cn"

        for section in model.sections:
            # KeywordSection has .body with Keyword items
            section_type = type(section).__name__
            if section_type != "KeywordSection":
                continue
            for item in section.body:
                item_type = type(item).__name__
                if item_type != "Keyword":
                    continue
                kw_name = item.name
                if not kw_name:
                    continue

                # deduplicate
                key = f"{kw_name}||{rel_path}"
                if key in self._seen:
                    continue
                self._seen.add(key)

                # collect arguments
                args = []
                doc_str = ""
                tags = []
                for stmt in item.body:
                    stmt_type = type(stmt).__name__
                    if stmt_type == "Arguments":
                        args = [str(a) for a in stmt.values]
                    elif stmt_type == "Documentation":
                        doc_str = stmt.value or ""
                    elif stmt_type == "Tags":
                        tags = list(stmt.values)

                self.keywords.append(KeywordInfo(
                    name=kw_name,
                    source_file=rel_path,
                    source_type="resource",
                    library_or_resource=lib_name,
                    arguments=args,
                    doc=doc_str,
                    tags=tags,
                ))

    # ── Python library scanning ─────────────────────────────────────────────

    def _scan_python_libs(self):
        """Use robot.libdocpkg to get keywords from .py files in Resources/keywords."""
        py_dir = self.project_root / "Resources" / "keywords"
        if not py_dir.exists():
            return

        for py_file in py_dir.glob("*.py"):
            if py_file.name.startswith("_"):
                continue
            self._load_lib_by_path(str(py_file), source_type="python_lib")

    def _load_lib_by_path(self, lib_path: str, source_type: str = "python_lib"):
        """Load a library by file path using libdoc."""
        try:
            from robot.libdocpkg import LibraryDocumentation
            spec = LibraryDocumentation(lib_path)
            self._extract_from_libdoc(spec, source_type=source_type, source_file=lib_path)
        except Exception as e:
            logger.debug(f"[Scanner] libdoc failed for {lib_path}: {e}")

    def _load_lib_by_name(self, lib_name: str, source_type: str = "builtin"):
        """Load a library by name (must be installed)."""
        try:
            from robot.libdocpkg import LibraryDocumentation
            spec = LibraryDocumentation(lib_name)
            self._extract_from_libdoc(spec, source_type=source_type, source_file=lib_name)
        except Exception as e:
            logger.debug(f"[Scanner] libdoc failed for lib '{lib_name}': {e}")

    def _extract_from_libdoc(self, spec, source_type: str, source_file: str):
        lib_name = spec.name or Path(source_file).stem
        try:
            rel_source = str(Path(source_file).relative_to(self.project_root)).replace("\\", "/")
        except ValueError:
            rel_source = source_file

        for kw in spec.keywords:
            key = f"{kw.name}||{lib_name}"
            if key in self._seen:
                continue
            self._seen.add(key)

            args = []
            for arg in kw.args:
                arg_str = arg.name
                if arg.default is not None:
                    arg_str += f"={arg.default}"
                args.append(arg_str)

            self.keywords.append(KeywordInfo(
                name=kw.name,
                source_file=rel_source,
                source_type=source_type,
                library_or_resource=lib_name,
                arguments=args,
                doc=kw.doc or "",
                tags=list(kw.tags) if kw.tags else [],
            ))

    # ── Built-in library scanning ───────────────────────────────────────────

    def _scan_builtin_libs(self):
        for lib in self.BUILTIN_LIBS:
            self._load_lib_by_name(lib, source_type="builtin")
        for lib in self.EXTRA_LIBS:
            self._load_lib_by_name(lib, source_type="installed_lib")


# ─── Index ─────────────────────────────────────────────────────────────────────

class KeywordIndex:
    """In-memory index with search capabilities over KeywordInfo list."""

    def __init__(self, keywords: list[KeywordInfo]):
        self.keywords = keywords
        # name -> list (same name can exist in multiple sources)
        self._by_name: dict[str, list[KeywordInfo]] = {}
        # library_or_resource -> list
        self._by_source: dict[str, list[KeywordInfo]] = {}

        for kw in keywords:
            self._by_name.setdefault(kw.name.lower(), []).append(kw)
            self._by_source.setdefault(kw.library_or_resource.lower(), []).append(kw)

    def search(self, query: str, limit: int = 20, source_filter: Optional[str] = None) -> list[KeywordInfo]:
        """
        Full-text search across keyword name + doc + tags.
        source_filter: partial match against library_or_resource name.
        """
        q = query.lower()
        results = []
        for kw in self.keywords:
            if source_filter and source_filter.lower() not in kw.library_or_resource.lower():
                continue
            score = 0
            name_lower = kw.name.lower()
            if q == name_lower:
                score = 100
            elif name_lower.startswith(q):
                score = 80
            elif q in name_lower:
                score = 60
            elif q in kw.doc.lower():
                score = 30
            elif any(q in t.lower() for t in kw.tags):
                score = 20
            # word-level partial: split query by space
            else:
                words = q.split()
                if words and all(w in name_lower or w in kw.doc.lower() for w in words):
                    score = 40
            if score > 0:
                results.append((score, kw))
        results.sort(key=lambda x: -x[0])
        return [kw for _, kw in results[:limit]]

    def get_by_name(self, name: str) -> list[KeywordInfo]:
        return self._by_name.get(name.lower(), [])

    def list_sources(self) -> list[dict]:
        return [
            {"source": src, "count": len(kws)}
            for src, kws in sorted(self._by_source.items())
        ]

    def get_by_source(self, source: str) -> list[KeywordInfo]:
        return self._by_source.get(source.lower(), [])

    def stats(self) -> dict:
        from collections import Counter
        by_type = Counter(kw.source_type for kw in self.keywords)
        return {
            "total": len(self.keywords),
            "by_type": dict(by_type),
            "sources": len(self._by_source),
        }
