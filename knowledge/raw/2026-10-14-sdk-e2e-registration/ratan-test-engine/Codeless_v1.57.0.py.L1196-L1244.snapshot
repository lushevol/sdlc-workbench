    def genfiles(self, robotfolder,  **script_dict):
        for k, v in script_dict.items():
            d = os.path.join(robotfolder, k)
            with open(d, 'wb') as py:
                py.write(v.encode('utf-8'))

    def __autocode__(self, filename, robotfolder):
        ac = API_Auto_Code()
        excelcases = ac.excel2dict(filename)
        script_dict, result, message = ac.dict2code(*excelcases)
        ac.genfiles(robotfolder, **script_dict)
        return result
    
    def change_robot_to_rbt(self, type, folder_path):
        # Get robot Path and File Name
        robot_files = []
        for root, dirs, files in os.walk(folder_path):
            for dir in dirs:
                #if dir.startswith("api") or dir.startswith("ui"):
                if dir==type:
                    #print(dir)
                    dir_path = os.path.join(root, dir)
                    for file in os.listdir(dir_path):
                        if file.endswith(".robot"):
                            file_path = os.path.join(dir_path, file)
                            file_name = file.replace(".robot", ".rbt")
                            robot_files.append((file_path, file_name))
        #print(robot_files)
        #Create Or Clear rbt Dir
        rbt_folder_path = os.path.join(folder_path, "rbt-" + type)
        if not os.path.exists(rbt_folder_path):
            os.makedirs(rbt_folder_path)
        else:
            for file_name in os.listdir(rbt_folder_path):
                file_path = os.path.join(rbt_folder_path, file_name)
                if os.path.isfile(file_path):
                    os.remove(file_path)
                elif os.path.isdir(file_path):
                    os.rmdir(file_path)

        # change format
        for file_path, file_name in robot_files:
            #print(file_path)
            #print(file_name)
            suite = TestSuite.from_file_system(file_path)
            data = suite.to_json(indent=2)
            with open(os.path.join(rbt_folder_path, file_name), 'w', encoding='utf-8') as file:
                file.write(data)
                file.close
