  "claim_register": [
    {
      "id": "KT-settlement-processing-and-exception-controls:1",
      "section": "Maker-checker exception handling",
      "claim_scope": "The NSTP design uses exception-specific maker, checker, authority-limit, and automatic-resolution rules.\nRejected SSI input preserves the maker values.\nRepeated blind verification covers mismatched or newly enriched fields.\nAd-hoc SSI retains maker input despite later upstream refresh.\nPreviously netted cashflows require an approver distinct from the unnetting user.\nHigh-value manual-touch handling applies above USD100 million in this historical table.",
      "bindings": [
