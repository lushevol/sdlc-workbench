# Copy to .env at the workspace root. Process environment values take precedence.
# Configure only the systems you use. Keep credentials out of tracked files.
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
SCWIKI_URL=
SCWIKI_TOKEN=
SCWIKI_WIKI=xwiki
NEXUS_BASE_URL=
NEXUS_USER_CODE=
NEXUS_PASS_CODE=
SONAR_BASE_URL=
SONAR_TOKEN=

# Optional network settings. Use NODE_EXTRA_CA_CERTS for a private certificate authority.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# Relative certificate paths resolve from this workspace root.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem

# Optional workspace-relative review guide.
CODE_REVIEW_GUIDE_FILE=
