# Copy to .env at the workspace root. Process environment values take precedence.
# Configure only the systems you use. Keep credentials out of tracked files.
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_PAT=
CONFLUENCE_BASE_URL=
CONFLUENCE_PAT=
SCWIKI_URL=
SCWIKI_TOKEN=
SCWIKI_WIKI=xwiki
NEXUS_BASE_URL=
NEXUS_USER_CODE=
NEXUS_PASS_CODE=
SONAR_BASE_URL=
SONAR_TOKEN=

# Optional network settings. Use NODE_EXTRA_CA_CERTS for a private certificate authority.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# Relative certificate paths resolve from this workspace root.
# NODE_EXTRA_CA_CERTS=/absolute/path/to/company-ca.pem

# Optional workspace-relative review guide.
CODE_REVIEW_GUIDE_FILE=

# Release Clinic uses the connector keys above for ADO, Confluence, Sonar, and SCWiki.
# Legacy ADO_TOKEN, CONFLUENCE_TOKEN, and SONAR_URL values remain supported.
# Set the organization URL above, including the collection path for ADO Server.
ADO_PROJECT=FMQPR
USER_EMAIL=
CONFLUENCE_SPACE_KEY=DTP
GENIE_REPORT_LINK=
GENIE_TOKEN=

# Optional ServiceNow integration. Stream configuration can override SNOW_ENABLED.
SNOW_ENABLED=false
SN_INSTANCE=
SNOW_API_PATH=api/x_235492_api_fra_0/api_framework/getapi/getChanges
CLIENT_ID=
FERNET_KEY=
SNOW_BLADE_KEY=

# Release Clinic paths resolve from this project root. Empty config paths use shipped defaults.
TDA_OUTPUT_DIR=.workbench/release-clinic/reports
TDA_LOG_DIR=.workbench/release-clinic/logs
TDA_REGISTRY_PATH=
TDA_STREAM_CONFIG=
TDA_FIELD_CONFIG=
STREAM_CONFIG_FILE=
PARALLEL_ENABLED=false
ADO_THROTTLE_DELAY_MS=1000
GENIE_TIMEOUT_SECONDS=60
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BACKOFF_SECONDS=1.0

# Optional hosted service. Use development mode only for local environment credentials.
VAULT_DEV_MODE=false
VAULT_ADDR=
VAULT_NAMESPACE=
HC_ROLE_ID=
HC_SECRET_ID=
HC_VAULT_AUTH_PATH=auth/approle/login
HC_VAULT_SECRET_PATH=
WORKER_POOL_SIZE=4
SERVICE_BASE_URL=http://localhost:8080
