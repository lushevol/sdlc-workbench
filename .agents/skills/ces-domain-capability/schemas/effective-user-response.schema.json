{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:workbench:ces:effective-user-response:1",
  "title": "CES effective-user response",
  "description": "Captured application-scoped access. An empty array represents no returned record.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "user_data",
      "entitlements"
    ],
    "properties": {
      "user_data": {
        "type": "object",
        "required": [
          "app_name",
          "user_id"
        ],
        "properties": {
          "app_name": {
            "type": "string",
            "minLength": 1
          },
          "user_id": {
            "type": "string",
            "minLength": 1
          },
          "itam_id": {
            "type": "string"
          }
        }
      },
      "entitlements": {
        "type": "object",
        "required": [
          "entitlement_name",
          "role_entitlements"
        ],
        "properties": {
          "entitlement_name": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "role_entitlements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "feature",
                "action"
              ],
              "properties": {
                "feature": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "data_policies": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "data_policy_name",
                  "policy_owner"
                ],
                "properties": {
                  "data_policy_name": {
                    "type": "string"
                  },
                  "policy_owner": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "data_profiles": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "data_profile_name",
                  "data_profile_owner"
                ],
                "properties": {
                  "data_profile_name": {
                    "type": "string"
                  },
                  "data_profile_owner": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "data_entitlements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "values"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "maxItems": 1
}
