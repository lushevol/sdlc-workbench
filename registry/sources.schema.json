{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workbench sources registry",
  "description": "The loader also checks IDs, unique lists, cross references, candidate contracts, and source restrictions.",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "purpose",
          "location"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "git",
              "filesystem",
              "xwiki",
              "confluence",
              "ado",
              "email",
              "teams"
            ]
          },
          "purpose": {
            "type": "string",
            "enum": [
              "technical",
              "context"
            ]
          },
          "read_only": {
            "type": "boolean",
            "default": true
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "ownership": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "team": {
                "type": "string",
                "minLength": 1
              },
              "contact": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
